# Copy to .env and fill in as needed. Nothing here is required for
# `--mode backtest` or `--mode demo`; live-mode extras (sentiment trading,
# database/event-streaming persistence) read these if you enable them.

# Sentiment trading strategy (SentimentAnalysisTrader)
NEWS_API_KEY=

# Database persistence (trading_simulator.persistence.DbLogger)
DATABASE_URL=postgresql://user:pass@localhost/trading_db

# Event streaming publishers (trading_simulator.core -- optional)
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Defaults used when a CLI flag isn't passed (see trading_simulator/config.py)
DEFAULT_INITIAL_CASH=1000000
DEFAULT_FEE_BPS=1.0
DEFAULT_MAKER_REBATE_BPS=0.5
MAX_ORDER_QTY=1000
MAX_SYMBOL_POSITION=10000
MAX_GROSS_NOTIONAL=5000000
