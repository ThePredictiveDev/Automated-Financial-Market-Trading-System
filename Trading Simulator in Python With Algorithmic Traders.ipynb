    HIGH_FREQUENCY_TRADING = "hft_burst"

@dataclass
class MarketEvent:
    """Represents a market event with its parameters."""
    event_type: MarketEventType
    start_time: datetime
    duration: timedelta
    affected_symbols: List[str]
    severity: float  # 0.0 to 1.0
    price_impact: float  # percentage impact
    volume_multiplier: float
    volatility_multiplier: float
    description: str
    
class MarketEventSimulator:
    """Simulates various market events and their impacts on trading."""
    
    def __init__(self, market_data_feed):
        self.market_data_feed = market_data_feed
        self.active_events = []
        self.event_history = []
        self.subscribers = []  # Components that react to market events
        
    def subscribe(self, subscriber):
        """Subscribe to market events."""
        self.subscribers.append(subscriber)
        
    def notify_subscribers(self, event: MarketEvent):
        """Notify all subscribers of a market event."""
        for subscriber in self.subscribers:
            if hasattr(subscriber, 'on_market_event'):
                subscriber.on_market_event(event)
    
    def simulate_market_crash(self, symbols: List[str], severity: float = 0.3, 
                            duration_hours: int = 6) -> MarketEvent:
        """Simulate a market crash event."""
        event = MarketEvent(
            event_type=MarketEventType.MARKET_CRASH,
            start_time=datetime.now(),
            duration=timedelta(hours=duration_hours),
            affected_symbols=symbols,
            severity=severity,
            price_impact=-severity * 0.3,  # 30% max crash
            volume_multiplier=3.0 + severity * 2,
            volatility_multiplier=2.0 + severity * 3,
            description=f"Market crash with {severity*100:.1f}% severity affecting {len(symbols)} symbols"
        )
        
        self.trigger_event(event)
        return event
    
    def simulate_flash_crash(self, symbols: List[str], severity: float = 0.1, 
                           duration_minutes: int = 15) -> MarketEvent:
        """Simulate a flash crash - rapid price decline and recovery."""
        event = MarketEvent(
            event_type=MarketEventType.FLASH_CRASH,
            start_time=datetime.now(),
            duration=timedelta(minutes=duration_minutes),
            affected_symbols=symbols,
            severity=severity,
            price_impact=-severity * 0.5,  # 50% max flash crash
            volume_multiplier=10.0 + severity * 5,
            volatility_multiplier=5.0 + severity * 5,
            description=f"Flash crash with {severity*100:.1f}% severity"
        )
        
        self.trigger_event(event)
        return event
    
    def simulate_volatility_spike(self, symbols: List[str], multiplier: float = 3.0, 
                                duration_hours: int = 2) -> MarketEvent:
        """Simulate increased market volatility."""
        event = MarketEvent(
            event_type=MarketEventType.VOLATILITY_SPIKE,
            start_time=datetime.now(),
            duration=timedelta(hours=duration_hours),
            affected_symbols=symbols,
            severity=min(multiplier / 5.0, 1.0),
            price_impact=random.uniform(-0.05, 0.05),  # Random small impact
            volume_multiplier=1.5 + multiplier * 0.3,
            volatility_multiplier=multiplier,
            description=f"Volatility spike with {multiplier}x normal volatility"
        )
        
        self.trigger_event(event)
        return event
    
    def simulate_news_event(self, symbols: List[str], sentiment: str = "neutral", 
                          impact: float = 0.1, duration_hours: int = 4) -> MarketEvent:
        """Simulate a news-driven market event."""
        price_impact = impact if sentiment == "positive" else -impact if sentiment == "negative" else 0
        
        event = MarketEvent(
            event_type=MarketEventType.NEWS_EVENT,
            start_time=datetime.now(),
            duration=timedelta(hours=duration_hours),
            affected_symbols=symbols,
            severity=abs(impact),
            price_impact=price_impact,
            volume_multiplier=1.5 + abs(impact) * 2,
            volatility_multiplier=1.2 + abs(impact),
            description=f"{sentiment.capitalize()} news event with {impact*100:.1f}% impact"
        )
        
        self.trigger_event(event)
        return event
    
    def simulate_earnings_announcement(self, symbol: str, surprise: float = 0.0, 
                                     duration_hours: int = 1) -> MarketEvent:
        """Simulate earnings announcement impact."""
        # surprise: -1.0 (big miss) to 1.0 (big beat)
        price_impact = surprise * 0.15  # Up to 15% move
        
        event = MarketEvent(
            event_type=MarketEventType.EARNINGS_ANNOUNCEMENT,
            start_time=datetime.now(),
            duration=timedelta(hours=duration_hours),
            affected_symbols=[symbol],
            severity=abs(surprise),
            price_impact=price_impact,
            volume_multiplier=2.0 + abs(surprise) * 3,
            volatility_multiplier=1.5 + abs(surprise) * 2,
            description=f"Earnings {'beat' if surprise > 0 else 'miss' if surprise < 0 else 'in-line'} for {symbol}"
        )
        
        self.trigger_event(event)
        return event
    
    def simulate_hft_burst(self, symbols: List[str], duration_seconds: int = 30) -> MarketEvent:
        """Simulate high-frequency trading burst affecting order book."""
        event = MarketEvent(
            event_type=MarketEventType.HIGH_FREQUENCY_TRADING,
            start_time=datetime.now(),
            duration=timedelta(seconds=duration_seconds),
            affected_symbols=symbols,
            severity=0.5,
            price_impact=random.uniform(-0.01, 0.01),  # Small price impact
            volume_multiplier=20.0,  # Massive volume spike
            volatility_multiplier=2.0,
            description=f"HFT burst affecting {len(symbols)} symbols"
        )
        
        self.trigger_event(event)
        return event
    
    def trigger_event(self, event: MarketEvent):
        """Trigger a market event and apply its effects."""
        self.active_events.append(event)
        self.event_history.append(event)
        self.notify_subscribers(event)
        
        logging.info(f"Market event triggered: {event.description}")
        
        # Apply immediate price impact
        for symbol in event.affected_symbols:
            self.apply_price_impact(symbol, event)
    
    def apply_price_impact(self, symbol: str, event: MarketEvent):
        """Apply price impact from market event."""
        if hasattr(self.market_data_feed, 'apply_event_impact'):
            self.market_data_feed.apply_event_impact(symbol, event)
    
    def update_active_events(self):
        """Update and remove expired events."""
        current_time = datetime.now()
        self.active_events = [
            event for event in self.active_events 
            if current_time < event.start_time + event.duration
        ]
    
    def get_active_event_impact(self, symbol: str) -> Tuple[float, float, float]:
        """Get cumulative impact of all active events on a symbol."""
        price_impact = 0.0
        volume_multiplier = 1.0
        volatility_multiplier = 1.0
        
        for event in self.active_events:
            if symbol in event.affected_symbols:
                # For flash crashes, apply time-based recovery
                if event.event_type == MarketEventType.FLASH_CRASH:
                    elapsed = datetime.now() - event.start_time
                    recovery_factor = min(elapsed.total_seconds() / event.duration.total_seconds(), 1.0)
                    recovery_factor = recovery_factor ** 0.5  # Square root recovery
                    current_impact = event.price_impact * (1 - recovery_factor)
                else:
                    current_impact = event.price_impact
                
                price_impact += current_impact
                volume_multiplier *= event.volume_multiplier
                volatility_multiplier *= event.volatility_multiplier
        
        return price_impact, volume_multiplier, volatility_multiplier
    
    def schedule_random_events(self, symbols: List[str], probability_per_hour: float = 0.1):
        """Schedule random market events based on probability."""
        if random.random() < probability_per_hour:
            event_type = random.choice(list(MarketEventType))
            affected_symbols = random.sample(symbols, random.randint(1, min(3, len(symbols))))
            
            if event_type == MarketEventType.MARKET_CRASH:
                self.simulate_market_crash(affected_symbols, random.uniform(0.1, 0.4))
            elif event_type == MarketEventType.FLASH_CRASH:
                self.simulate_flash_crash(affected_symbols, random.uniform(0.05, 0.2))
            elif event_type == MarketEventType.VOLATILITY_SPIKE:
                self.simulate_volatility_spike(affected_symbols, random.uniform(2.0, 5.0))
            elif event_type == MarketEventType.NEWS_EVENT:
                sentiment = random.choice(["positive", "negative", "neutral"])
                self.simulate_news_event(affected_symbols, sentiment, random.uniform(0.02, 0.1))
    
    def create_stress_test_scenario(self, symbols: List[str]) -> List[MarketEvent]:
        """Create a comprehensive stress test scenario."""
        events = []
        base_time = datetime.now()
        
        # Day 1: Normal volatility spike
        events.append(MarketEvent(
            event_type=MarketEventType.VOLATILITY_SPIKE,
            start_time=base_time + timedelta(hours=1),
            duration=timedelta(hours=3),
            affected_symbols=symbols,
            severity=0.6,
            price_impact=0.0,
            volume_multiplier=2.0,
            volatility_multiplier=3.0,
            description="Stress test: Initial volatility spike"
        ))
        
        # Day 2: Flash crash
        events.append(MarketEvent(
            event_type=MarketEventType.FLASH_CRASH,
            start_time=base_time + timedelta(days=1, hours=2),
            duration=timedelta(minutes=30),
            affected_symbols=symbols,
            severity=0.8,
            price_impact=-0.15,
            volume_multiplier=15.0,
            volatility_multiplier=8.0,
            description="Stress test: Flash crash"
        ))
        
        # Day 3: Market crash
        events.append(MarketEvent(
            event_type=MarketEventType.MARKET_CRASH,
            start_time=base_time + timedelta(days=2, hours=1),
            duration=timedelta(hours=8),
            affected_symbols=symbols,
            severity=0.9,
            price_impact=-0.25,
            volume_multiplier=5.0,
            volatility_multiplier=4.0,
            description="Stress test: Major market crash"
        ))
        
        return events
    
    def get_event_statistics(self) -> Dict:
        """Get statistics about simulated events."""
        if not self.event_history:
            return {}
        
        event_counts = {}
        total_impact = 0.0
        
        for event in self.event_history:
            event_type = event.event_type.value
            event_counts[event_type] = event_counts.get(event_type, 0) + 1
            total_impact += abs(event.price_impact)
        
        return {
            'total_events': len(self.event_history),
            'event_types': event_counts,
            'average_impact': total_impact / len(self.event_history) if self.event_history else 0,
            'active_events': len(self.active_events)
