class Position:
    """Represents a trading position with comprehensive tracking."""
    
    def __init__(self, symbol: str, side: str, quantity: int, entry_price: float, 
                 timestamp: datetime = None, stop_loss: float = None, take_profit: float = None):
        self.id = str(uuid.uuid4())
        self.symbol = symbol
        self.side = side  # 'long' or 'short'
        self.quantity = quantity
        self.entry_price = entry_price
        self.current_price = entry_price
        self.timestamp = timestamp or datetime.now()
        self.stop_loss = stop_loss
        self.take_profit = take_profit
        self.realized_pnl = 0.0
        self.unrealized_pnl = 0.0
        self.trades = []  # Track individual trades that built this position
        
    def update_price(self, new_price: float):
        """Update current price and calculate unrealized PnL."""
        self.current_price = new_price
        if self.side == 'long':
            self.unrealized_pnl = (new_price - self.entry_price) * self.quantity
        else:  # short
            self.unrealized_pnl = (self.entry_price - new_price) * self.quantity
    
    def close_position(self, exit_price: float, partial_quantity: int = None):
        """Close position (fully or partially) and realize PnL."""
        close_qty = partial_quantity or self.quantity
        
        if self.side == 'long':
            pnl = (exit_price - self.entry_price) * close_qty
        else:
            pnl = (self.entry_price - exit_price) * close_qty
            
        self.realized_pnl += pnl
        self.quantity -= close_qty
        
        if self.quantity <= 0:
            self.quantity = 0
            self.unrealized_pnl = 0
            
        return pnl
    
    def should_trigger_stop_loss(self) -> bool:
        """Check if stop loss should be triggered."""
        if not self.stop_loss:
            return False
        return (self.side == 'long' and self.current_price <= self.stop_loss) or \
               (self.side == 'short' and self.current_price >= self.stop_loss)
    
    def should_trigger_take_profit(self) -> bool:
        """Check if take profit should be triggered."""
        if not self.take_profit:
            return False
        return (self.side == 'long' and self.current_price >= self.take_profit) or \
               (self.side == 'short' and self.current_price <= self.take_profit)

class RiskMetrics:
    """Calculate various risk metrics for portfolios and strategies."""
    
    @staticmethod
    def calculate_sharpe_ratio(returns: List[float], risk_free_rate: float = 0.02) -> float:
        """Calculate Sharpe ratio."""
        if not returns or len(returns) < 2:
            return 0.0
        
        excess_returns = np.array(returns) - risk_free_rate / 252  # Daily risk-free rate
        return np.mean(excess_returns) / np.std(excess_returns) * np.sqrt(252) if np.std(excess_returns) > 0 else 0.0
    
    @staticmethod
    def calculate_max_drawdown(equity_curve: List[float]) -> Tuple[float, int, int]:
        """Calculate maximum drawdown and its duration."""
        if not equity_curve:
            return 0.0, 0, 0
            
        equity_array = np.array(equity_curve)
        peak = np.maximum.accumulate(equity_array)
        drawdown = (equity_array - peak) / peak
        
        max_dd = np.min(drawdown)
        max_dd_idx = np.argmin(drawdown)
        
        # Find start of drawdown
        start_idx = 0
        for i in range(max_dd_idx, -1, -1):
            if drawdown[i] == 0:
                start_idx = i
                break
                
        return abs(max_dd), start_idx, max_dd_idx
    
    @staticmethod
    def calculate_var(returns: List[float], confidence_level: float = 0.05) -> float:
        """Calculate Value at Risk (VaR)."""
        if not returns:
            return 0.0
        return np.percentile(returns, confidence_level * 100)
    
    @staticmethod
    def calculate_calmar_ratio(returns: List[float], equity_curve: List[float]) -> float:
        """Calculate Calmar ratio (annual return / max drawdown)."""
        if not returns or not equity_curve:
            return 0.0
            
        annual_return = np.mean(returns) * 252
        max_dd, _, _ = RiskMetrics.calculate_max_drawdown(equity_curve)
        
        return annual_return / max_dd if max_dd > 0 else 0.0

class Portfolio:
    """Enhanced portfolio management with risk controls and analytics."""
    
    def __init__(self, initial_capital: float = 100000, max_position_size: float = 0.1, 
                 max_portfolio_risk: float = 0.02):
        self.initial_capital = initial_capital
        self.cash = initial_capital
        self.positions: Dict[str, Position] = {}
        self.trade_history = []
        self.equity_curve = [initial_capital]
        self.returns = []
        self.max_position_size = max_position_size  # % of portfolio
        self.max_portfolio_risk = max_portfolio_risk  # % daily VaR limit
        self.total_fees_paid = 0.0
        self.daily_pnl_history = []
        
    def get_total_equity(self) -> float:
        """Calculate total portfolio equity."""
        position_value = sum(pos.quantity * pos.current_price for pos in self.positions.values())
        unrealized_pnl = sum(pos.unrealized_pnl for pos in self.positions.values())
        return self.cash + position_value + unrealized_pnl
    
    def get_position_value(self, symbol: str) -> float:
        """Get current value of a position."""
        if symbol in self.positions:
            pos = self.positions[symbol]
            return pos.quantity * pos.current_price
        return 0.0
    
    def check_position_size_limit(self, symbol: str, quantity: int, price: float) -> bool:
        """Check if new position would exceed size limits."""
        position_value = quantity * price
        total_equity = self.get_total_equity()
        position_pct = position_value / total_equity
        
        return position_pct <= self.max_position_size
    
    def calculate_position_size(self, symbol: str, price: float, risk_per_trade: float = 0.01) -> int:
        """Calculate optimal position size based on risk management."""
        total_equity = self.get_total_equity()
        max_position_value = total_equity * self.max_position_size
        risk_amount = total_equity * risk_per_trade
        
        # Simple position sizing based on price (could be enhanced with volatility)
        max_shares_by_value = int(max_position_value / price)
        max_shares_by_risk = int(risk_amount / (price * 0.02))  # Assuming 2% stop loss
        
        return min(max_shares_by_value, max_shares_by_risk)
    
    def open_position(self, symbol: str, side: str, quantity: int, price: float, 
                     stop_loss: float = None, take_profit: float = None, 
                     fees: float = 0.0) -> bool:
        """Open a new position or add to existing one."""
        position_value = quantity * price
        
        if position_value + fees > self.cash:
            logging.warning(f"Insufficient cash for position: {symbol}")
            return False
            
        if not self.check_position_size_limit(symbol, quantity, price):
            logging.warning(f"Position size limit exceeded for: {symbol}")
            return False
        
        # Deduct cash and fees
        self.cash -= (position_value + fees)
        self.total_fees_paid += fees
        
        if symbol in self.positions:
            # Add to existing position (weighted average entry price)
            existing_pos = self.positions[symbol]
            total_quantity = existing_pos.quantity + quantity
            new_entry_price = ((existing_pos.entry_price * existing_pos.quantity) + 
                             (price * quantity)) / total_quantity
            existing_pos.quantity = total_quantity
            existing_pos.entry_price = new_entry_price
        else:
            # Create new position
            self.positions[symbol] = Position(
                symbol, side, quantity, price, datetime.now(), stop_loss, take_profit
            )
        
        # Record trade
        trade_record = {
            'timestamp': datetime.now(),
            'symbol': symbol,
            'side': side,
            'action': 'open',
            'quantity': quantity,
            'price': price,
            'fees': fees,
            'portfolio_value': self.get_total_equity()
        }
        self.trade_history.append(trade_record)
        
        logging.info(f"Opened {side} position: {quantity} {symbol} @ {price}")
        return True
    
    def close_position(self, symbol: str, quantity: int = None, price: float = None, 
                      fees: float = 0.0) -> bool:
        """Close position (fully or partially)."""
        if symbol not in self.positions:
            logging.warning(f"No position found for: {symbol}")
            return False
        
        position = self.positions[symbol]
        close_quantity = quantity or position.quantity
        close_price = price or position.current_price
        
        if close_quantity > position.quantity:
            logging.warning(f"Cannot close more shares than owned: {symbol}")
            return False
        
        # Realize PnL
        pnl = position.close_position(close_price, close_quantity)
        
        # Add cash from sale
        self.cash += (close_quantity * close_price - fees)
        self.total_fees_paid += fees
        
        # Record trade
        trade_record = {
            'timestamp': datetime.now(),
            'symbol': symbol,
            'side': 'close',
            'action': 'close',
            'quantity': close_quantity,
            'price': close_price,
            'pnl': pnl,
            'fees': fees,
            'portfolio_value': self.get_total_equity()
        }
        self.trade_history.append(trade_record)
        
        # Remove position if fully closed
        if position.quantity == 0:
            del self.positions[symbol]
        
        logging.info(f"Closed position: {close_quantity} {symbol} @ {close_price}, PnL: {pnl:.2f}")
        return True
    
    def update_positions(self, market_data: Dict[str, float]):
        """Update all positions with new market prices."""
        for symbol, position in self.positions.items():
            if symbol in market_data:
                position.update_price(market_data[symbol])
                
                # Check stop loss and take profit
                if position.should_trigger_stop_loss():
                    logging.info(f"Stop loss triggered for {symbol} at {position.current_price}")
                    self.close_position(symbol, price=position.stop_loss)
                elif position.should_trigger_take_profit():
                    logging.info(f"Take profit triggered for {symbol} at {position.current_price}")
                    self.close_position(symbol, price=position.take_profit)
    
    def update_equity_curve(self):
        """Update equity curve and calculate returns."""
        current_equity = self.get_total_equity()
        self.equity_curve.append(current_equity)
        
        if len(self.equity_curve) > 1:
            daily_return = (current_equity - self.equity_curve[-2]) / self.equity_curve[-2]
            self.returns.append(daily_return)
    
    def get_performance_metrics(self) -> Dict:
        """Calculate comprehensive performance metrics."""
        if len(self.returns) < 2:
            return {}
        
        total_return = (self.get_total_equity() - self.initial_capital) / self.initial_capital
        max_dd, dd_start, dd_end = RiskMetrics.calculate_max_drawdown(self.equity_curve)
        sharpe = RiskMetrics.calculate_sharpe_ratio(self.returns)
        calmar = RiskMetrics.calculate_calmar_ratio(self.returns, self.equity_curve)
        var_5 = RiskMetrics.calculate_var(self.returns, 0.05)
        
        winning_trades = [t for t in self.trade_history if t.get('pnl', 0) > 0]
        losing_trades = [t for t in self.trade_history if t.get('pnl', 0) < 0]
        
        return {
            'total_return': total_return,
            'annualized_return': np.mean(self.returns) * 252 if self.returns else 0,
            'volatility': np.std(self.returns) * np.sqrt(252) if self.returns else 0,
            'sharpe_ratio': sharpe,
            'calmar_ratio': calmar,
            'max_drawdown': max_dd,
            'var_5': var_5,
            'total_trades': len([t for t in self.trade_history if 'pnl' in t]),
            'winning_trades': len(winning_trades),
            'losing_trades': len(losing_trades),
            'win_rate': len(winning_trades) / len([t for t in self.trade_history if 'pnl' in t]) if self.trade_history else 0,
            'avg_win': np.mean([t['pnl'] for t in winning_trades]) if winning_trades else 0,
            'avg_loss': np.mean([t['pnl'] for t in losing_trades]) if losing_trades else 0,
            'total_fees': self.total_fees_paid,
            'current_equity': self.get_total_equity()
        }
    
    def get_portfolio_summary(self) -> pd.DataFrame:
        """Get current portfolio positions as DataFrame."""
        if not self.positions:
            return pd.DataFrame()
        
        data = []
        for symbol, pos in self.positions.items():
            data.append({
                'Symbol': symbol,
                'Side': pos.side,
                'Quantity': pos.quantity,
                'Entry Price': pos.entry_price,
                'Current Price': pos.current_price,
                'Market Value': pos.quantity * pos.current_price,
                'Unrealized PnL': pos.unrealized_pnl,
                'Stop Loss': pos.stop_loss,
                'Take Profit': pos.take_profit
            })
        
        return pd.DataFrame(data)
    
    def plot_equity_curve(self):
        """Plot portfolio equity curve."""
        plt.figure(figsize=(12, 6))
        plt.plot(self.equity_curve, label='Portfolio Value')
        plt.axhline(y=self.initial_capital, color='r', linestyle='--', label='Initial Capital')
        plt.title('Portfolio Equity Curve')
        plt.xlabel('Time')
        plt.ylabel('Portfolio Value ($)')
        plt.legend()
        plt.grid(True)
        plt.show()
    
    def save_portfolio_state(self, filename: str):
        """Save portfolio state to file."""
        state = {
            'cash': self.cash,
            'positions': {k: vars(v) for k, v in self.positions.items()},
            'trade_history': self.trade_history,
            'equity_curve': self.equity_curve,
            'returns': self.returns,
            'total_fees_paid': self.total_fees_paid
        }
        
        with open(filename, 'w') as f:
            json.dump(state, f, default=str, indent=2)## Enhanced Portfolio and Risk Management System## Enhanced Trading Simulator Features

