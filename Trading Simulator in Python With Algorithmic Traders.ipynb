# Example 5: Real-time Monitoring and Analysis
def example_monitoring():
    simulator = TradingSimulator(initial_capital=100000, mode='live')
    
    # Function to monitor portfolio in real-time
    def monitor_portfolio():
        while simulator.running:
            # Get portfolio summary
            portfolio = simulator.get_portfolio_summary()
            risk_metrics = simulator.get_risk_metrics()
            
            # Display key metrics
            print(f"\n{'='*50}")
            print(f"Portfolio Value: ${portfolio['total_value']:,.2f}")
            print(f"Total P&L: ${portfolio['total_pnl']:,.2f}")
            print(f"Daily P&L: ${risk_metrics['daily_pnl']:,.2f} "
                  f"({risk_metrics['daily_pnl_pct']:.2f}%)")
            print(f"Current Leverage: {risk_metrics['current_leverage']:.2f}x")
            print(f"VaR (95%): ${risk_metrics['var_95']:,.2f}")
            
            # Check positions
            if portfolio['positions']:
                print("\nOpen Positions:")
                for symbol, pos in portfolio['positions'].items():
                    print(f"  {symbol}: {pos['quantity']} shares @ "
                          f"${pos['average_price']:.2f}, "
                          f"P&L: ${pos['unrealized_pnl']:.2f} "
                          f"({pos['unrealized_pnl_pct']:.2f}%)")
            
            time.sleep(10)  # Update every 10 seconds
    
    # Start monitoring in separate thread
    monitor_thread = threading.Thread(target=monitor_portfolio)
    monitor_thread.start()
    
    return simulator

