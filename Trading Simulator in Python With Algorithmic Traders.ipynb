    def calculate_monthly_returns(self, trade_history: List[Dict]) -> Dict:
        """Calculate monthly returns from trade history."""
        monthly_returns = {}
        
        for trade in trade_history:
            if 'pnl' in trade and 'timestamp' in trade:
                month_key = f"{trade['timestamp'].year}-{trade['timestamp'].month:02d}"
                if month_key not in monthly_returns:
                    monthly_returns[month_key] = 0.0
                monthly_returns[month_key] += trade['pnl']
        
        return monthly_returns
    
    def plot_monthly_returns_heatmap(self, monthly_returns: Dict):
        """Plot monthly returns as a heatmap."""
        # Convert to matrix format for heatmap
        years = sorted(set(int(k.split('-')[0]) for k in monthly_returns.keys()))
        months = range(1, 13)
        
        data_matrix = np.zeros((len(years), 12))
        
        for i, year in enumerate(years):
            for j, month in enumerate(months):
                key = f"{year}-{month:02d}"
                if key in monthly_returns:
                    data_matrix[i, j] = monthly_returns[key]
        
        sns.heatmap(data_matrix, 
                   xticklabels=['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                              'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                   yticklabels=years,
                   annot=True, fmt='.1f', cmap='RdYlGn', center=0)
    
    def calculate_rolling_sharpe(self, returns: List[float], window: int = 30) -> List[float]:
        """Calculate rolling Sharpe ratio."""
        rolling_sharpe = []
        
        for i in range(window, len(returns)):
            window_returns = returns[i-window:i]
            sharpe = RiskMetrics.calculate_sharpe_ratio(window_returns)
            rolling_sharpe.append(sharpe)
            
        return rolling_sharpe

class RealTimeAnalytics:
    """Real-time analytics and monitoring."""
    
    def __init__(self, update_frequency: int = 60):
        self.update_frequency = update_frequency
        self.metrics_history = []
        self.alerts = []
        
    def monitor_portfolio(self, portfolio: Portfolio, alert_thresholds: Dict):
        """Monitor portfolio in real-time and generate alerts."""
        while True:
            current_metrics = portfolio.get_performance_metrics()
            current_metrics['timestamp'] = datetime.now()
            
            self.metrics_history.append(current_metrics)
            
            # Check alert conditions
            self.check_alerts(current_metrics, alert_thresholds)
            
            time.sleep(self.update_frequency)
    
    def check_alerts(self, metrics: Dict, thresholds: Dict):
        """Check for alert conditions."""
        alerts = []
        
        # Drawdown alert
        if 'max_drawdown' in metrics and 'max_drawdown' in thresholds:
            if metrics['max_drawdown'] > thresholds['max_drawdown']:
                alerts.append(f"Drawdown alert: {metrics['max_drawdown']:.2%} exceeds threshold {thresholds['max_drawdown']:.2%}")
        
        # VaR alert
        if 'var_5' in metrics and 'var_5' in thresholds:
            if metrics['var_5'] < thresholds['var_5']:
                alerts.append(f"VaR alert: {metrics['var_5']:.2%} breaches threshold {thresholds['var_5']:.2%}")
        
        # Win rate alert
        if 'win_rate' in metrics and 'min_win_rate' in thresholds:
            if metrics['win_rate'] < thresholds['min_win_rate']:
                alerts.append(f"Win rate alert: {metrics['win_rate']:.2%} below threshold {thresholds['min_win_rate']:.2%}")
        
        # Store alerts
        for alert in alerts:
            self.alerts.append({
                'timestamp': datetime.now(),
                'message': alert,
                'severity': 'warning'
            })
            logging.warning(alert)
    
    def generate_real_time_report(self) -> str:
        """Generate a real-time performance report."""
        if not self.metrics_history:
            return "No data available for real-time report."
        
        latest = self.metrics_history[-1]
        
        report = f"""
REAL-TIME PORTFOLIO REPORT
Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
{'='*50}

Current Equity: ${latest.get('current_equity', 0):,.2f}
Total Return: {latest.get('total_return', 0):.2%}
Sharpe Ratio: {latest.get('sharpe_ratio', 0):.3f}
Max Drawdown: {latest.get('max_drawdown', 0):.2%}
Win Rate: {latest.get('win_rate', 0):.2%}

Recent Alerts ({len(self.alerts)} total):
"""
        
        # Add recent alerts
        recent_alerts = self.alerts[-5:] if len(self.alerts) > 5 else self.alerts
        for alert in recent_alerts:
            report += f"  - {alert['timestamp'].strftime('%H:%M:%S')}: {alert['message']}\n"
        
        return report## Enhanced Data Management and Analyticsclass StrategyParameter:
    """Represents a strategy parameter that can be optimized."""
    
    def __init__(self, name: str, min_value: float, max_value: float, 
                 step_size: float = None, parameter_type: str = "float"):
        self.name = name
        self.min_value = min_value
        self.max_value = max_value
        self.step_size = step_size or (max_value - min_value) / 20
        self.parameter_type = parameter_type
        
    def get_values(self) -> List:
        """Get all possible values for this parameter."""
        if self.parameter_type == "int":
            return list(range(int(self.min_value), int(self.max_value) + 1, int(self.step_size)))
        else:
            values = []
            current = self.min_value
            while current <= self.max_value:
                values.append(current)
                current += self.step_size
            return values

class StrategyTestResult:
    """Contains the results of a strategy test."""
    
    def __init__(self, strategy_name: str, parameters: Dict, 
                 start_date: str, end_date: str):
        self.strategy_name = strategy_name
        self.parameters = parameters
        self.start_date = start_date
        self.end_date = end_date
        self.trades = []
        self.equity_curve = []
        self.returns = []
        self.metrics = {}
        self.max_drawdown = 0.0
        self.sharpe_ratio = 0.0
        self.total_return = 0.0
        self.win_rate = 0.0
        self.profit_factor = 0.0
        
    def calculate_metrics(self):
        """Calculate performance metrics from trades and equity curve."""
        if not self.trades:
            return
            
        # Basic metrics
        winning_trades = [t for t in self.trades if t.get('pnl', 0) > 0]
        losing_trades = [t for t in self.trades if t.get('pnl', 0) < 0]
        
        self.win_rate = len(winning_trades) / len(self.trades) if self.trades else 0
        
        total_profit = sum(t['pnl'] for t in winning_trades)
        total_loss = abs(sum(t['pnl'] for t in losing_trades))
        self.profit_factor = total_profit / total_loss if total_loss > 0 else float('inf')
        
        # Calculate from equity curve
        if len(self.equity_curve) > 1:
            self.total_return = (self.equity_curve[-1] - self.equity_curve[0]) / self.equity_curve[0]
            
            # Calculate returns
            self.returns = []
            for i in range(1, len(self.equity_curve)):
                ret = (self.equity_curve[i] - self.equity_curve[i-1]) / self.equity_curve[i-1]
                self.returns.append(ret)
            
            # Advanced metrics
            self.sharpe_ratio = RiskMetrics.calculate_sharpe_ratio(self.returns)
            max_dd, _, _ = RiskMetrics.calculate_max_drawdown(self.equity_curve)
            self.max_drawdown = max_dd
            
        self.metrics = {
            'total_return': self.total_return,
            'sharpe_ratio': self.sharpe_ratio,
            'max_drawdown': self.max_drawdown,
            'win_rate': self.win_rate,
            'profit_factor': self.profit_factor,
            'total_trades': len(self.trades),
            'avg_trade': np.mean([t['pnl'] for t in self.trades]) if self.trades else 0
        }

class StrategyOptimizer:
    """Optimize strategy parameters using various algorithms."""
    
    def __init__(self, strategy_factory, data_source, optimization_metric: str = "sharpe_ratio"):
        self.strategy_factory = strategy_factory
        self.data_source = data_source
        self.optimization_metric = optimization_metric
        self.results = []
        
    def grid_search(self, parameters: List[StrategyParameter], 
                   symbol: str, start_date: str, end_date: str) -> List[StrategyTestResult]:
        """Perform grid search optimization."""
        # Generate all parameter combinations
        param_combinations = []
        param_names = [p.name for p in parameters]
        param_values = [p.get_values() for p in parameters]
        
        import itertools
        for combination in itertools.product(*param_values):
            param_dict = dict(zip(param_names, combination))
            param_combinations.append(param_dict)
        
        logging.info(f"Testing {len(param_combinations)} parameter combinations")
        
        # Test each combination
        results = []
        for i, params in enumerate(param_combinations):
            if i % 10 == 0:
                logging.info(f"Progress: {i}/{len(param_combinations)}")
                
            result = self.test_strategy_with_parameters(symbol, start_date, end_date, params)
            results.append(result)
        
        # Sort by optimization metric
        results.sort(key=lambda r: r.metrics.get(self.optimization_metric, 0), reverse=True)
        self.results = results
        return results
    
    def random_search(self, parameters: List[StrategyParameter], 
                     symbol: str, start_date: str, end_date: str, 
                     num_iterations: int = 100) -> List[StrategyTestResult]:
        """Perform random search optimization."""
        results = []
        
        for i in range(num_iterations):
            # Generate random parameters
            params = {}
            for param in parameters:
                if param.parameter_type == "int":
                    value = random.randint(int(param.min_value), int(param.max_value))
                else:
                    value = random.uniform(param.min_value, param.max_value)
                params[param.name] = value
            
            result = self.test_strategy_with_parameters(symbol, start_date, end_date, params)
            results.append(result)
            
            if i % 10 == 0:
                logging.info(f"Random search progress: {i}/{num_iterations}")
        
        results.sort(key=lambda r: r.metrics.get(self.optimization_metric, 0), reverse=True)
        self.results = results
        return results
    
    def test_strategy_with_parameters(self, symbol: str, start_date: str, end_date: str, 
                                    parameters: Dict) -> StrategyTestResult:
        """Test a strategy with specific parameters."""
        # Create strategy instance
        strategy = self.strategy_factory(symbol=symbol, **parameters)
        
        # Create test environment
        portfolio = Portfolio(initial_capital=100000)
        order_book = EnhancedOrderBook()
        matching_engine = MatchingEngine(order_book)
        
        # Load historical data
        historical_data = yf.download(symbol, start=start_date, end=end_date, interval="1d")
        historical_data.reset_index(inplace=True)
        
        # Run backtest
        for index, row in historical_data.iterrows():
            market_data = {
                'symbol': symbol,
                'timestamp': row['Date'],
                'price': row['Close'],
                'volume': row['Volume'],
                'high': row['High'],
                'low': row['Low'],
                'open': row['Open']
            }
            
            # Update strategy
            if hasattr(strategy, 'update'):
                strategy.update(market_data)
            
            # Generate signals
            if hasattr(strategy, 'generate_signal'):
                signal = strategy.generate_signal(market_data)
                
                if signal and signal['action'] in ['buy', 'sell']:
                    # Execute trade through portfolio
                    if signal['action'] == 'buy':
                        quantity = portfolio.calculate_position_size(symbol, row['Close'])
                        if quantity > 0:
                            portfolio.open_position(symbol, 'long', quantity, row['Close'])
                    elif signal['action'] == 'sell' and symbol in portfolio.positions:
                        portfolio.close_position(symbol, price=row['Close'])
            
            # Update portfolio
            portfolio.update_positions({symbol: row['Close']})
            portfolio.update_equity_curve()
        
        # Create result
        result = StrategyTestResult(
            strategy_name=strategy.__class__.__name__,
            parameters=parameters,
            start_date=start_date,
            end_date=end_date
        )
        
        result.trades = portfolio.trade_history
        result.equity_curve = portfolio.equity_curve
        result.calculate_metrics()
        
        return result
    
    def get_best_parameters(self) -> Dict:
        """Get the best parameter set from optimization."""
        if not self.results:
            return {}
        return self.results[0].parameters
    
    def plot_optimization_results(self, top_n: int = 10):
        """Plot optimization results."""
        if not self.results:
            return
            
        top_results = self.results[:top_n]
        
        fig, axes = plt.subplots(2, 2, figsize=(15, 10))
        
        # Plot metric comparison
        metrics = [r.metrics.get(self.optimization_metric, 0) for r in top_results]
        axes[0, 0].bar(range(len(metrics)), metrics)
        axes[0, 0].set_title(f'Top {top_n} Results by {self.optimization_metric}')
        axes[0, 0].set_xlabel('Strategy Rank')
        axes[0, 0].set_ylabel(self.optimization_metric)
        
        # Plot equity curves
        for i, result in enumerate(top_results[:5]):
            axes[0, 1].plot(result.equity_curve, label=f'Rank {i+1}', alpha=0.7)
        axes[0, 1].set_title('Top 5 Equity Curves')
        axes[0, 1].legend()
        
        # Plot return vs risk
        returns = [r.metrics.get('total_return', 0) for r in top_results]
        risks = [r.metrics.get('max_drawdown', 0) for r in top_results]
        axes[1, 0].scatter(risks, returns)
        axes[1, 0].set_xlabel('Max Drawdown')
        axes[1, 0].set_ylabel('Total Return')
        axes[1, 0].set_title('Return vs Risk')
        
        # Plot parameter analysis (if only one parameter varies)
        if len(self.results) > 1:
            param_name = list(self.results[0].parameters.keys())[0]
            param_values = [r.parameters[param_name] for r in self.results]
            metric_values = [r.metrics.get(self.optimization_metric, 0) for r in self.results]
            axes[1, 1].scatter(param_values, metric_values)
            axes[1, 1].set_xlabel(param_name)
            axes[1, 1].set_ylabel(self.optimization_metric)
            axes[1, 1].set_title(f'{self.optimization_metric} vs {param_name}')
        
        plt.tight_layout()
        plt.show()

class MonteCarloSimulator:
    """Perform Monte Carlo simulations for strategy testing."""
    
    def __init__(self, base_returns: List[float]):
        self.base_returns = np.array(base_returns)
        self.mean_return = np.mean(base_returns)
        self.std_return = np.std(base_returns)
        
    def simulate_price_paths(self, initial_price: float, num_days: int, 
                           num_simulations: int = 1000) -> np.ndarray:
        """Simulate multiple price paths using geometric Brownian motion."""
        dt = 1/252  # Daily time step
        drift = self.mean_return - 0.5 * self.std_return**2
        
        # Generate random shocks
        shocks = np.random.normal(0, 1, (num_simulations, num_days))
        
        # Calculate price paths
        price_paths = np.zeros((num_simulations, num_days + 1))
        price_paths[:, 0] = initial_price
        
        for i in range(num_days):
            price_paths[:, i+1] = price_paths[:, i] * np.exp(
                drift * dt + self.std_return * np.sqrt(dt) * shocks[:, i]
            )
        
        return price_paths
    
    def stress_test_strategy(self, strategy_factory, symbol: str, 
                           num_simulations: int = 100, days: int = 252) -> Dict:
        """Stress test a strategy using Monte Carlo simulation."""
        # Get current price
        ticker = yf.Ticker(symbol)
        current_price = ticker.history(period="1d")['Close'].iloc[-1]
        
        # Generate price paths
        price_paths = self.simulate_price_paths(current_price, days, num_simulations)
        
        results = []
        
        for sim in range(num_simulations):
            # Create strategy and portfolio
            strategy = strategy_factory(symbol=symbol)
            portfolio = Portfolio(initial_capital=100000)
            
            # Run simulation
            prices = price_paths[sim]
            for day, price in enumerate(prices[1:]):
                market_data = {
                    'symbol': symbol,
                    'price': price,
                    'timestamp': datetime.now() + timedelta(days=day)
                }
                
                # Update strategy and generate signals
                if hasattr(strategy, 'update'):
                    strategy.update(market_data)
                
                if hasattr(strategy, 'generate_signal'):
                    signal = strategy.generate_signal(market_data)
                    
                    if signal and signal['action'] in ['buy', 'sell']:
                        if signal['action'] == 'buy':
                            quantity = portfolio.calculate_position_size(symbol, price)
                            if quantity > 0:
                                portfolio.open_position(symbol, 'long', quantity, price)
                        elif signal['action'] == 'sell' and symbol in portfolio.positions:
                            portfolio.close_position(symbol, price=price)
                
                # Update portfolio
                portfolio.update_positions({symbol: price})
                portfolio.update_equity_curve()
            
            # Record results
            final_value = portfolio.get_total_equity()
            total_return = (final_value - portfolio.initial_capital) / portfolio.initial_capital
            results.append({
                'final_value': final_value,
                'total_return': total_return,
                'max_drawdown': RiskMetrics.calculate_max_drawdown(portfolio.equity_curve)[0],
                'sharpe_ratio': RiskMetrics.calculate_sharpe_ratio(portfolio.returns) if portfolio.returns else 0
            })
        
        # Analyze results
        returns = [r['total_return'] for r in results]
        max_drawdowns = [r['max_drawdown'] for r in results]
        sharpe_ratios = [r['sharpe_ratio'] for r in results]
        
        analysis = {
            'num_simulations': num_simulations,
            'mean_return': np.mean(returns),
            'std_return': np.std(returns),
            'var_5': np.percentile(returns, 5),
            'var_1': np.percentile(returns, 1),
            'mean_max_drawdown': np.mean(max_drawdowns),
            'worst_case_drawdown': np.max(max_drawdowns),
            'mean_sharpe': np.mean(sharpe_ratios),
            'probability_of_loss': len([r for r in returns if r < 0]) / len(returns),
            'results': results
        }
        
        return analysis

class WalkForwardAnalysis:
    """Perform walk-forward analysis for strategy validation."""
    
    def __init__(self, strategy_factory, optimizer: StrategyOptimizer):
        self.strategy_factory = strategy_factory
        self.optimizer = optimizer
        
    def perform_analysis(self, symbol: str, start_date: str, end_date: str,
                        optimization_window_days: int = 252,
                        reoptimization_frequency_days: int = 63,
                        parameters: List[StrategyParameter] = None) -> Dict:
        """Perform walk-forward analysis."""
        
        # Load full dataset
        data = yf.download(symbol, start=start_date, end=end_date, interval="1d")
        data.reset_index(inplace=True)
        
        results = []
        optimization_points = []
        
        current_date = pd.to_datetime(start_date) + timedelta(days=optimization_window_days)
        
        while current_date < pd.to_datetime(end_date):
            # Define optimization period
            opt_start = current_date - timedelta(days=optimization_window_days)
            opt_end = current_date
            
            # Define testing period
            test_start = current_date
            test_end = min(current_date + timedelta(days=reoptimization_frequency_days), 
                          pd.to_datetime(end_date))
            
            logging.info(f"Optimizing: {opt_start.date()} to {opt_end.date()}")
            logging.info(f"Testing: {test_start.date()} to {test_end.date()}")
            
            # Optimize parameters
            if parameters:
                opt_results = self.optimizer.grid_search(
                    parameters, symbol, 
                    opt_start.strftime('%Y-%m-%d'), 
                    opt_end.strftime('%Y-%m-%d')
                )
                best_params = opt_results[0].parameters if opt_results else {}
            else:
                best_params = {}
            
            # Test with optimized parameters
            test_result = self.optimizer.test_strategy_with_parameters(
                symbol, 
                test_start.strftime('%Y-%m-%d'),
                test_end.strftime('%Y-%m-%d'),
                best_params
            )
            
            results.append(test_result)
            optimization_points.append({
                'date': current_date,
                'parameters': best_params,
                'in_sample_performance': opt_results[0].metrics if parameters and opt_results else {},
                'out_sample_performance': test_result.metrics
            })
            
            # Move to next period
            current_date += timedelta(days=reoptimization_frequency_days)
        
        # Analyze overall performance
        combined_equity = []
        combined_trades = []
        
        for result in results:
            combined_trades.extend(result.trades)
            if combined_equity:
                # Normalize to continue from previous equity
                scaling_factor = combined_equity[-1] / result.equity_curve[0]
                scaled_curve = [val * scaling_factor for val in result.equity_curve[1:]]
                combined_equity.extend(scaled_curve)
            else:
                combined_equity.extend(result.equity_curve)
        
        # Calculate overall metrics
        if len(combined_equity) > 1:
            total_return = (combined_equity[-1] - combined_equity[0]) / combined_equity[0]
            returns = []
            for i in range(1, len(combined_equity)):
                ret = (combined_equity[i] - combined_equity[i-1]) / combined_equity[i-1]
                returns.append(ret)
            
            overall_metrics = {
                'total_return': total_return,
                'sharpe_ratio': RiskMetrics.calculate_sharpe_ratio(returns),
                'max_drawdown': RiskMetrics.calculate_max_drawdown(combined_equity)[0],
                'total_trades': len(combined_trades),
                'win_rate': len([t for t in combined_trades if t.get('pnl', 0) > 0]) / len(combined_trades) if combined_trades else 0
            }
        else:
            overall_metrics = {}
        
        return {
            'individual_results': results,
            'optimization_points': optimization_points,
            'combined_equity_curve': combined_equity,
            'overall_metrics': overall_metrics,
            'parameter_stability': self._analyze_parameter_stability(optimization_points)
        }
    
    def _analyze_parameter_stability(self, optimization_points: List[Dict]) -> Dict:
        """Analyze parameter stability across optimization periods."""
        if not optimization_points:
            return {}
        
        # Get all parameter names
        param_names = set()
        for point in optimization_points:
            param_names.update(point['parameters'].keys())
        
        stability_metrics = {}
        
        for param_name in param_names:
            values = [point['parameters'].get(param_name, 0) for point in optimization_points]
            if values:
                stability_metrics[param_name] = {
                    'mean': np.mean(values),
                    'std': np.std(values),
                    'coefficient_of_variation': np.std(values) / np.mean(values) if np.mean(values) != 0 else float('inf'),
                    'min': np.min(values),
                    'max': np.max(values)
                }
        
        return stability_metrics## Advanced Strategy Testing Frameworkclass OrderType(Enum):
