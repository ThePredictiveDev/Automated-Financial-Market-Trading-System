def auto_inject_liquidity(liquidity_provider, interval_seconds):
    """Auto-inject liquidity at regular intervals."""
    while True:
        liquidity_provider.generate_liquidity()
        time.sleep(interval_seconds)

class EnhancedTradingSimulator:
    """Main simulator class that integrates all enhanced components."""
    
    def __init__(self, initial_capital: float = 100000, symbols: List[str] = None):
        # Core components
        self.portfolio = Portfolio(initial_capital=initial_capital)
        self.order_book = EnhancedOrderBook()
        self.matching_engine = MatchingEngine(self.order_book)
        self.symbols = symbols or ["AAPL", "MSFT", "GOOGL"]
        
        # Enhanced components
        self.market_event_simulator = MarketEventSimulator(None)
        self.algo_order_manager = AlgorithmicOrderManager(self.order_book, None)
        self.data_manager = DataManager()
        self.performance_analyzer = PerformanceAnalyzer()
        self.real_time_analytics = RealTimeAnalytics()
        
        # Traders and strategies
        self.active_traders = []
        self.market_makers = []
        
        # State
        self.running = False
        self.simulation_start_time = None
        
    def add_trader(self, trader_class, **kwargs):
        """Add a trading strategy to the simulation."""
        for symbol in self.symbols:
            trader = trader_class(symbol=symbol, matching_engine=self.matching_engine, **kwargs)
            self.active_traders.append(trader)
            logging.info(f"Added {trader_class.__name__} for {symbol}")
    
    def add_market_maker(self, symbol: str, **kwargs):
        """Add a market maker for a symbol."""
        market_maker = MarketMaker(symbol=symbol, matching_engine=self.matching_engine, **kwargs)
        self.market_makers.append(market_maker)
        logging.info(f"Added MarketMaker for {symbol}")
    
    def simulate_market_event(self, event_type: str, symbols: List[str] = None, **kwargs):
        """Trigger a market event during simulation."""
        symbols = symbols or self.symbols
        
        if event_type == "crash":
            return self.market_event_simulator.simulate_market_crash(symbols, **kwargs)
        elif event_type == "flash_crash":
            return self.market_event_simulator.simulate_flash_crash(symbols, **kwargs)
        elif event_type == "volatility_spike":
            return self.market_event_simulator.simulate_volatility_spike(symbols, **kwargs)
        elif event_type == "news":
            return self.market_event_simulator.simulate_news_event(symbols, **kwargs)
        elif event_type == "earnings":
            symbol = symbols[0] if symbols else self.symbols[0]
            return self.market_event_simulator.simulate_earnings_announcement(symbol, **kwargs)
        else:
            logging.warning(f"Unknown event type: {event_type}")
    
    def run_historical_simulation(self, start_date: str, end_date: str, 
                                speed_multiplier: float = 1000.0):
        """Run simulation using historical data."""
        self.simulation_start_time = datetime.now()
        self.running = True
        
        logging.info(f"Starting historical simulation from {start_date} to {end_date}")
        
        # Load historical data for all symbols
        historical_data = {}
        for symbol in self.symbols:
            historical_data[symbol] = self.data_manager.load_stored_data(symbol, start_date, end_date)
        
        # Get the maximum length to ensure all symbols are processed
        max_length = max(len(data) for data in historical_data.values())
        
        for i in range(max_length):
            if not self.running:
                break
                
            # Update market data for all symbols
            market_data = {}
            for symbol in self.symbols:
                if i < len(historical_data[symbol]):
                    row = historical_data[symbol].iloc[i]
                    market_data[symbol] = row['Close']
                    
                    # Update individual market data for traders
                    individual_data = {
                        'symbol': symbol,
                        'timestamp': row['Date'],
                        'price': row['Close'],
                        'volume': row['Volume'],
                        'high': row['High'],
                        'low': row['Low'],
                        'open': row['Open']
                    }
                    
                    # Update traders
                    for trader in self.active_traders:
                        if trader.symbol == symbol and hasattr(trader, 'on_market_data'):
                            trader.on_market_data(individual_data)
                    
                    # Update market makers
                    for mm in self.market_makers:
                        if mm.symbol == symbol:
                            mm.on_market_data(individual_data)
            
            # Update portfolio with current prices
            self.portfolio.update_positions(market_data)
            self.portfolio.update_equity_curve()
            
            # Process algorithmic orders
            current_volume = {symbol: historical_data[symbol].iloc[i]['Volume'] 
                            if i < len(historical_data[symbol]) else 0 
                            for symbol in self.symbols}
            self.algo_order_manager.process_algo_orders(current_volume)
            
            # Update market events
            self.market_event_simulator.update_active_events()
            
            # Simulate some delay for realistic timing
            if speed_multiplier > 0:
                time.sleep(1.0 / speed_multiplier)
        
        logging.info("Historical simulation completed")
        self.running = False
    
    def run_live_simulation(self, duration_hours: float = 1.0):
        """Run live simulation with real-time market data."""
        self.simulation_start_time = datetime.now()
        self.running = True
        end_time = datetime.now() + timedelta(hours=duration_hours)
        
        logging.info(f"Starting live simulation for {duration_hours} hours")
        
        # Start market data feeds for each symbol
        feeds = {}
        feed_threads = []
        
        for symbol in self.symbols:
            feed = MarketDataFeed(symbol)
            feeds[symbol] = feed
            
            # Subscribe traders and market makers
            for trader in self.active_traders:
                if trader.symbol == symbol:
                    feed.subscribe(trader)
            
            for mm in self.market_makers:
                if mm.symbol == symbol:
                    feed.subscribe(mm)
            
            # Start feed
            feed_thread = threading.Thread(target=feed.start)
            feed_thread.start()
            feed_threads.append(feed_thread)
        
        # Main simulation loop
        while datetime.now() < end_time and self.running:
            # Get current market prices
            current_prices = {}
            for symbol in self.symbols:
                try:
                    ticker = yf.Ticker(symbol)
                    current_prices[symbol] = ticker.history(period="1d", interval="1m").iloc[-1]['Close']
                except:
                    logging.warning(f"Failed to get current price for {symbol}")
            
            if current_prices:
                self.portfolio.update_positions(current_prices)
                self.portfolio.update_equity_curve()
            
            # Random market events
            if random.random() < 0.001:  # 0.1% chance per iteration
                event_types = ["volatility_spike", "news", "hft_burst"]
                event_type = random.choice(event_types)
                affected_symbols = random.sample(self.symbols, random.randint(1, len(self.symbols)))
                
                if event_type == "volatility_spike":
                    self.market_event_simulator.simulate_volatility_spike(affected_symbols)
                elif event_type == "news":
                    sentiment = random.choice(["positive", "negative", "neutral"])
                    self.market_event_simulator.simulate_news_event(affected_symbols, sentiment=sentiment)
                elif event_type == "hft_burst":
                    self.market_event_simulator.simulate_hft_burst(affected_symbols)
            
            time.sleep(10)  # Update every 10 seconds
        
        # Stop all feeds
        for feed in feeds.values():
            feed.stop()
        
        for thread in feed_threads:
            thread.join(timeout=5)
        
        logging.info("Live simulation completed")
        self.running = False
    
    def run_strategy_optimization(self, strategy_class, parameters: List[StrategyParameter],
                                 start_date: str, end_date: str, symbol: str = None):
        """Run strategy optimization."""
        symbol = symbol or self.symbols[0]
        
        # Create strategy factory
        def strategy_factory(**kwargs):
            return strategy_class(symbol=symbol, matching_engine=self.matching_engine, **kwargs)
        
        # Create optimizer
        optimizer = StrategyOptimizer(strategy_factory, self.data_manager)
        
        # Run optimization
        results = optimizer.grid_search(parameters, symbol, start_date, end_date)
        
        # Plot results
        optimizer.plot_optimization_results()
        
        return results
    
    def run_monte_carlo_stress_test(self, strategy_class, symbol: str = None, 
                                   num_simulations: int = 100):
        """Run Monte Carlo stress test."""
        symbol = symbol or self.symbols[0]
        
        # Get historical returns for the symbol
        historical_data = yf.download(symbol, period="2y", interval="1d")
        returns = historical_data['Close'].pct_change().dropna().tolist()
        
        # Create Monte Carlo simulator
        mc_simulator = MonteCarloSimulator(returns)
        
        # Create strategy factory
        def strategy_factory(**kwargs):
            return strategy_class(symbol=symbol, matching_engine=self.matching_engine, **kwargs)
        
        # Run stress test
        results = mc_simulator.stress_test_strategy(strategy_factory, symbol, num_simulations)
        
        # Print results
        print("\nMONTE CARLO STRESS TEST RESULTS")
        print("="*50)
        print(f"Simulations: {results['num_simulations']}")
        print(f"Mean Return: {results['mean_return']:.2%}")
        print(f"Std Return: {results['std_return']:.2%}")
        print(f"5% VaR: {results['var_5']:.2%}")
        print(f"1% VaR: {results['var_1']:.2%}")
        print(f"Mean Max Drawdown: {results['mean_max_drawdown']:.2%}")
        print(f"Worst Case Drawdown: {results['worst_case_drawdown']:.2%}")
        print(f"Probability of Loss: {results['probability_of_loss']:.2%}")
        print("="*50)
        
        return results
    
    def generate_comprehensive_report(self):
        """Generate a comprehensive performance report."""
        # Portfolio performance
        self.performance_analyzer.plot_performance_dashboard(self.portfolio, 
                                                           "Enhanced Trading Simulator Results")
        
        # Market events statistics
        event_stats = self.market_event_simulator.get_event_statistics()
        if event_stats:
            print("\nMARKET EVENTS SUMMARY")
            print("="*30)
            for key, value in event_stats.items():
                print(f"{key}: {value}")
            print("="*30)
        
        # Real-time analytics
        rt_report = self.real_time_analytics.generate_real_time_report()
        print(rt_report)
        
        return {
            'portfolio_metrics': self.portfolio.get_performance_metrics(),
            'event_statistics': event_stats,
            'trade_count': len(self.portfolio.trade_history),
            'simulation_duration': datetime.now() - self.simulation_start_time if self.simulation_start_time else None
        }
    
    def save_simulation_state(self, filename: str):
        """Save complete simulation state."""
        state = {
            'portfolio': {
                'cash': self.portfolio.cash,
                'equity_curve': self.portfolio.equity_curve,
                'trade_history': self.portfolio.trade_history,
                'returns': self.portfolio.returns
            },
            'market_events': self.market_event_simulator.event_history,
            'active_traders': [trader.__class__.__name__ for trader in self.active_traders],
            'symbols': self.symbols,
            'simulation_start_time': self.simulation_start_time
        }
        
        with open(filename, 'w') as f:
            json.dump(state, f, default=str, indent=2)
        
        logging.info(f"Simulation state saved to {filename}")
    
    def stop_simulation(self):
        """Stop the running simulation."""
        self.running = False
        logging.info("Simulation stop requested")

# Usage example functions
def create_enhanced_momentum_strategy():
    """Create an enhanced momentum strategy with risk management."""
    
    class EnhancedMomentumStrategy(MomentumTrader):
        def __init__(self, symbol, matching_engine, lookback=10, momentum_threshold=0.02, 
                     stop_loss_pct=0.05, take_profit_pct=0.10, **kwargs):
            super().__init__(symbol, matching_engine, lookback=lookback)
            self.momentum_threshold = momentum_threshold
            self.stop_loss_pct = stop_loss_pct
            self.take_profit_pct = take_profit_pct
            self.portfolio = Portfolio()
            
        def generate_signal(self, market_data):
            """Generate trading signals with risk management."""
            if len(self.prices) < self.lookback:
                return None
            
            # Calculate momentum
            momentum = (self.prices[-1] - self.prices[0]) / self.prices[0]
            
            # Generate signal
            if momentum > self.momentum_threshold:
                # Calculate position size and risk levels
                position_size = self.portfolio.calculate_position_size(self.symbol, self.current_price)
                stop_loss = self.current_price * (1 - self.stop_loss_pct)
                take_profit = self.current_price * (1 + self.take_profit_pct)
                
                return {
                    'action': 'buy',
                    'quantity': position_size,
                    'price': self.current_price,
                    'stop_loss': stop_loss,
                    'take_profit': take_profit,
                    'confidence': min(abs(momentum) / self.momentum_threshold, 1.0)
                }
            elif momentum < -self.momentum_threshold:
                return {
                    'action': 'sell',
                    'confidence': min(abs(momentum) / self.momentum_threshold, 1.0)
                }
            
            return None
    
    return EnhancedMomentumStrategy

