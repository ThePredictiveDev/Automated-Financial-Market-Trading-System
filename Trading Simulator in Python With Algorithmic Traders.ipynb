class LatencySimulator:
    """Simulates realistic trading latencies."""
    
    def __init__(self):
        self.base_latency_ms = 1.0  # Base latency in milliseconds
        self.network_jitter = 0.5   # Network jitter
        self.exchange_latency = 0.3 # Exchange processing time
        
    def calculate_latency(self, order_type: OrderType, market_conditions: str = "normal") -> float:
        """Calculate realistic latency based on order type and market conditions."""
        base = self.base_latency_ms
        
        # Order type multipliers
        type_multipliers = {
            OrderType.MARKET: 1.0,
            OrderType.LIMIT: 1.2,
            OrderType.STOP_LOSS: 1.5,
            OrderType.ICEBERG: 2.0,
            OrderType.TWAP: 1.8,
            OrderType.VWAP: 1.8
        }
        
        # Market condition multipliers
        condition_multipliers = {
            "normal": 1.0,
            "high_volatility": 2.0,
            "flash_crash": 5.0,
            "market_open": 1.5,
            "market_close": 1.5
        }
        
        latency = base * type_multipliers.get(order_type, 1.0) * condition_multipliers.get(market_conditions, 1.0)
        
        # Add random jitter
        jitter = random.uniform(-self.network_jitter, self.network_jitter)
        latency += jitter + self.exchange_latency
        
        return max(latency, 0.1)  # Minimum latency

class SlippageModel:
    """Models realistic slippage based on market conditions."""
    
    def __init__(self):
        self.base_slippage_bps = 2.0  # Base slippage in basis points
        self.impact_coefficient = 0.1  # Market impact coefficient
        
    def calculate_slippage(self, order: EnhancedOrder, market_volume: float, 
                          volatility: float, spread: float) -> float:
        """Calculate slippage for an order."""
        # Size impact - larger orders have more slippage
        size_factor = (order.quantity / market_volume) ** 0.5 if market_volume > 0 else 1.0
        
        # Volatility impact
        volatility_factor = 1.0 + volatility * 0.5
        
        # Spread impact
        spread_factor = 1.0 + spread * 0.1
        
        # Order type impact
        type_factors = {
            OrderType.MARKET: 1.5,  # Market orders have more slippage
            OrderType.LIMIT: 0.5,   # Limit orders have less slippage
            OrderType.STOP_LOSS: 2.0,  # Stop orders can have high slippage
            OrderType.ICEBERG: 0.8     # Iceberg orders reduce impact
        }
        
        slippage_bps = (self.base_slippage_bps * size_factor * volatility_factor * 
                       spread_factor * type_factors.get(order.order_type, 1.0))
        
        return slippage_bps / 10000  # Convert basis points to decimal

class TransactionCostModel:
    """Models comprehensive transaction costs."""
    
    def __init__(self):
        self.commission_rate = 0.0005  # 0.05% commission
        self.market_impact_coefficient = 0.1
        
    def calculate_total_cost(self, order: EnhancedOrder, fill_price: float, 
                           slippage: float) -> Tuple[float, Dict]:
        """Calculate total transaction costs."""
        notional = order.filled_quantity * fill_price
        
        # Commission
        commission = notional * self.commission_rate
        
        # Slippage cost
        slippage_cost = notional * abs(slippage)
        
        # Market impact (additional to slippage)
        market_impact = notional * self.market_impact_coefficient * 0.0001
        
        # Regulatory fees (small)
        regulatory_fees = notional * 0.0001
        
        total_cost = commission + slippage_cost + market_impact + regulatory_fees
        
        cost_breakdown = {
            'commission': commission,
            'slippage': slippage_cost,
            'market_impact': market_impact,
            'regulatory_fees': regulatory_fees,
            'total': total_cost
        }
        
        return total_cost, cost_breakdown

class EnhancedOrderBook(OrderBook):
    """Enhanced order book with sophisticated order handling."""
    
    def __init__(self):
        super().__init__()
        self.latency_simulator = LatencySimulator()
        self.slippage_model = SlippageModel()
        self.cost_model = TransactionCostModel()
        self.hidden_orders = {}  # Hidden/iceberg orders
        self.order_history = []
        
    def add_enhanced_order(self, order: EnhancedOrder) -> bool:
        """Add enhanced order with sophisticated handling."""
        # Simulate latency
        order.latency_ms = self.latency_simulator.calculate_latency(order.order_type)
        
        # Handle different order types
        if order.order_type == OrderType.ICEBERG:
            return self.handle_iceberg_order(order)
        elif order.order_type == OrderType.HIDDEN:
            return self.handle_hidden_order(order)
        elif order.order_type == OrderType.POST_ONLY:
            return self.handle_post_only_order(order)
        else:
            return self.handle_standard_order(order)
    
    def handle_iceberg_order(self, order: EnhancedOrder) -> bool:
        """Handle iceberg orders that show limited quantity."""
        # Store the full order details
        self.hidden_orders[order.id] = order
        
        # Create visible portion
        visible_order = Order(
            id=f"{order.id}_visible",
            price=order.price,
            quantity=min(order.display_quantity, order.remaining_quantity),
            side=order.side,
            type=order.order_type.value,
            symbol=order.symbol
        )
        
        self.add_order(visible_order)
        logging.info(f"Iceberg order added: {order.id}, showing {visible_order.quantity} of {order.quantity}")
        return True
    
    def handle_hidden_order(self, order: EnhancedOrder) -> bool:
        """Handle completely hidden orders."""
        self.hidden_orders[order.id] = order
        logging.info(f"Hidden order added: {order.id}")
        return True
    
    def handle_post_only_order(self, order: EnhancedOrder) -> bool:
        """Handle post-only orders that provide liquidity."""
        # Check if order would immediately match
        if order.side == 'buy' and self.get_best_ask() and order.price >= self.get_best_ask():
            order.status = OrderStatus.REJECTED
            logging.info(f"Post-only order rejected: {order.id} would take liquidity")
            return False
        elif order.side == 'sell' and self.get_best_bid() and order.price <= self.get_best_bid():
            order.status = OrderStatus.REJECTED
            logging.info(f"Post-only order rejected: {order.id} would take liquidity")
            return False
        
        return self.handle_standard_order(order)
    
    def handle_standard_order(self, order: EnhancedOrder) -> bool:
        """Handle standard order types."""
        # Convert to legacy Order format for existing matching engine
        legacy_order = Order(
            id=order.id,
            price=order.price,
            quantity=order.remaining_quantity,
            side=order.side,
            type=order.order_type.value,
            symbol=order.symbol
        )
        
        self.add_order(legacy_order)
        return True
    
    def replenish_iceberg_order(self, order_id: str):
        """Replenish visible portion of iceberg order when filled."""
        if order_id in self.hidden_orders:
            iceberg_order = self.hidden_orders[order_id]
            if iceberg_order.remaining_quantity > 0:
                new_visible_qty = min(iceberg_order.display_quantity, iceberg_order.remaining_quantity)
                
                visible_order = Order(
                    id=f"{order_id}_visible_{random.randint(1000, 9999)}",
                    price=iceberg_order.price,
                    quantity=new_visible_qty,
                    side=iceberg_order.side,
                    type="limit",
                    symbol=iceberg_order.symbol
                )
                
                self.add_order(visible_order)
                logging.info(f"Replenished iceberg order: {order_id}, new visible: {new_visible_qty}")

class AlgorithmicOrderManager:
    """Manages sophisticated algorithmic orders like TWAP and VWAP."""
    
    def __init__(self, order_book: EnhancedOrderBook, market_data_feed):
        self.order_book = order_book
        self.market_data_feed = market_data_feed
        self.active_algo_orders = {}
        
    def create_twap_order(self, symbol: str, side: str, total_quantity: int, 
                         duration_minutes: int, price_limit: float = None) -> str:
        """Create Time-Weighted Average Price order."""
        order_id = str(uuid.uuid4())
        
        slices = max(1, duration_minutes // 5)  # Execute every 5 minutes
        slice_quantity = total_quantity // slices
        
        algo_order = {
            'id': order_id,
            'type': 'TWAP',
            'symbol': symbol,
            'side': side,
            'total_quantity': total_quantity,
            'remaining_quantity': total_quantity,
            'slice_quantity': slice_quantity,
            'price_limit': price_limit,
            'start_time': datetime.now(),
            'duration': timedelta(minutes=duration_minutes),
            'next_execution': datetime.now() + timedelta(minutes=5),
            'executed_slices': []
        }
        
        self.active_algo_orders[order_id] = algo_order
        logging.info(f"TWAP order created: {order_id}, {total_quantity} {symbol} over {duration_minutes} minutes")
        return order_id
    
    def create_vwap_order(self, symbol: str, side: str, total_quantity: int, 
                         target_participation: float = 0.1) -> str:
        """Create Volume-Weighted Average Price order."""
        order_id = str(uuid.uuid4())
        
        algo_order = {
            'id': order_id,
            'type': 'VWAP',
            'symbol': symbol,
            'side': side,
            'total_quantity': total_quantity,
            'remaining_quantity': total_quantity,
            'target_participation': target_participation,
            'start_time': datetime.now(),
            'volume_tracker': [],
            'executed_slices': []
        }
        
        self.active_algo_orders[order_id] = algo_order
        logging.info(f"VWAP order created: {order_id}, {total_quantity} {symbol} with {target_participation*100}% participation")
        return order_id
    
    def process_algo_orders(self, current_volume: Dict[str, float]):
        """Process all active algorithmic orders."""
        current_time = datetime.now()
        
        for order_id, algo_order in list(self.active_algo_orders.items()):
            if algo_order['type'] == 'TWAP':
                self.process_twap_order(algo_order, current_time)
            elif algo_order['type'] == 'VWAP':
                self.process_vwap_order(algo_order, current_volume)
            
            # Remove completed orders
            if algo_order['remaining_quantity'] <= 0:
                del self.active_algo_orders[order_id]
                logging.info(f"Algorithmic order completed: {order_id}")
    
    def process_twap_order(self, algo_order: Dict, current_time: datetime):
        """Process TWAP order execution."""
        if current_time >= algo_order['next_execution'] and algo_order['remaining_quantity'] > 0:
            # Calculate slice size
            remaining_time = (algo_order['start_time'] + algo_order['duration']) - current_time
            remaining_slices = max(1, remaining_time.total_seconds() // 300)  # 5-minute slices
            
            slice_quantity = min(
                algo_order['slice_quantity'],
                algo_order['remaining_quantity'] // remaining_slices if remaining_slices > 0 else algo_order['remaining_quantity']
            )
            
            # Get current market price
            ticker = yf.Ticker(algo_order['symbol'])
            current_price = ticker.history(period="1d", interval="1m").iloc[-1]['Close']
            
            # Check price limit
            if algo_order['price_limit']:
                if (algo_order['side'] == 'buy' and current_price > algo_order['price_limit']) or \
                   (algo_order['side'] == 'sell' and current_price < algo_order['price_limit']):
                    # Skip this slice
                    algo_order['next_execution'] = current_time + timedelta(minutes=5)
                    return
            
            # Create and submit order slice
            slice_order = EnhancedOrder(
                id=f"{algo_order['id']}_slice_{len(algo_order['executed_slices'])}",
                symbol=algo_order['symbol'],
                side=algo_order['side'],
                order_type=OrderType.LIMIT,
                quantity=int(slice_quantity),
                price=current_price
            )
            
            self.order_book.add_enhanced_order(slice_order)
            algo_order['executed_slices'].append(slice_order)
            algo_order['remaining_quantity'] -= slice_quantity
            algo_order['next_execution'] = current_time + timedelta(minutes=5)
    
    def process_vwap_order(self, algo_order: Dict, current_volume: Dict[str, float]):
        """Process VWAP order execution."""
        symbol = algo_order['symbol']
        if symbol in current_volume and algo_order['remaining_quantity'] > 0:
            # Calculate target quantity based on volume participation
            target_qty = int(current_volume[symbol] * algo_order['target_participation'])
            target_qty = min(target_qty, algo_order['remaining_quantity'])
            
            if target_qty > 0:
                # Get current market price
                ticker = yf.Ticker(symbol)
                current_price = ticker.history(period="1d", interval="1m").iloc[-1]['Close']
                
                # Create and submit order slice
                slice_order = EnhancedOrder(
                    id=f"{algo_order['id']}_vwap_slice_{len(algo_order['executed_slices'])}",
                    symbol=symbol,
                    side=algo_order['side'],
                    order_type=OrderType.LIMIT,
                    quantity=target_qty,
                    price=current_price
                )
                
                self.order_book.add_enhanced_order(slice_order)
                algo_order['executed_slices'].append(slice_order)
