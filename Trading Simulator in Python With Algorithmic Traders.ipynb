# Example 5: Portfolio Risk Management
def risk_management_example():
    """Example of advanced portfolio risk management."""
    
    print("Demonstrating portfolio risk management...")
    
    # Create portfolio with risk limits
    portfolio = Portfolio(
        initial_capital=100000,
        max_position_size=0.15,  # Max 15% in any single position
        max_portfolio_risk=0.02  # Max 2% daily VaR
    )
    
    # Simulate some trades with risk management
    symbols = ["AAPL", "MSFT", "GOOGL", "TSLA", "AMZN"]
    
    for i, symbol in enumerate(symbols):
        # Calculate optimal position size
        price = 150 + i * 20  # Dummy prices
        position_size = portfolio.calculate_position_size(symbol, price, risk_per_trade=0.01)
        
        if position_size > 0:
            # Open position with stop loss and take profit
            stop_loss = price * 0.95  # 5% stop loss
            take_profit = price * 1.10  # 10% take profit
            
            success = portfolio.open_position(
                symbol, "long", position_size, price,
                stop_loss=stop_loss, take_profit=take_profit,
                fees=position_size * price * 0.001  # 0.1% fees
            )
            
            if success:
                print(f"Opened position: {position_size} shares of {symbol} @ ${price}")
        
        # Update with some price movements
        new_price = price * (1 + random.uniform(-0.05, 0.05))  # ±5% random move
        portfolio.update_positions({symbol: new_price})
    
    # Update equity curve
    portfolio.update_equity_curve()
    
    # Get performance metrics
    metrics = portfolio.get_performance_metrics()
    print(f"\nPortfolio Summary:")
    print(f"Total Equity: ${portfolio.get_total_equity():,.2f}")
    print(f"Cash: ${portfolio.cash:,.2f}")
    print(f"Number of Positions: {len(portfolio.positions)}")
    
    # Display portfolio
    portfolio_df = portfolio.get_portfolio_summary()
    if not portfolio_df.empty:
        print("\nCurrent Positions:")
        print(portfolio_df)
    
    return portfolio

