    "class MomentumTrader(AlgorithmicTrader):\n",
    "    def __init__(self, symbol, matching_engine, interval=0.1, lookback=5):\n",
    "        super().__init__(symbol, matching_engine, interval)\n",
    "        self.lookback = lookback\n",
    "        self.prices = []\n",
    "\n",
    "    def handle_market_data(self, data):\n",
    "        self.prices.append(self.current_price)\n",
    "        if len(self.prices) > self.lookback:\n",
    "            self.prices.pop(0)\n",
    "\n",
    "    def trade(self):\n",
    "        if len(self.prices) < self.lookback:\n",
    "            return\n",
    "\n",
    "        price_change = self.prices[-1] - self.prices[0]\n",
    "        if price_change > 0:\n",
    "            # Buy\n",
    "            order = Order(id=str(random.randint(10000, 99999)), price=self.current_price, quantity=100, side='buy', type='limit', symbol=self.symbol)\n",
    "            self.matching_engine.match_order(order)\n",
    "            logging.info(f\"MomentumTrader placed a buy order at {self.current_price}\")\n",
    "        elif price_change < 0:\n",
    "            # Sell\n",
    "            order = Order(id=str(random.randint(10000, 99999)), price=self.current_price, quantity=100, side='sell', type='limit', symbol=self.symbol)\n",
    "            self.matching_engine.match_order(order)\n",
    "            logging.info(f\"MomentumTrader placed a sell order at {self.current_price}\")\n"
   ]
