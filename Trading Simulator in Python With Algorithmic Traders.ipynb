    "class SwingTrader(AlgorithmicTrader):\n",
    "    def __init__(self, symbol, matching_engine, interval=0.1, support_level=100, resistance_level=200):\n",
    "        super().__init__(symbol, matching_engine, interval)\n",
    "        self.support_level = support_level\n",
    "        self.resistance_level = resistance_level\n",
    "\n",
    "    def trade(self):\n",
    "        if self.current_price:\n",
    "            if self.current_price <= self.support_level:\n",
    "                # Buy\n",
    "                order = Order(id=str(random.randint(10000, 99999)), price=self.current_price, quantity=100, side='buy', type='limit', symbol=self.symbol)\n",
    "                self.matching_engine.match_order(order)\n",
    "                logging.info(f\"SwingTrader placed a buy order at {self.current_price}\")\n",
    "            elif self.current_price >= self.resistance_level:\n",
    "                # Sell\n",
    "                order = Order(id=str(random.randint(10000, 99999)), price=self.current_price, quantity=100, side='sell', type='limit', symbol=self.symbol)\n",
    "                self.matching_engine.match_order(order)\n",
    "                logging.info(f\"SwingTrader placed a sell order at {self.current_price}\")\n",
    "\n",
    "    def handle_market_data(self, data):\n",
    "        self.current_price = data['price']\n"
