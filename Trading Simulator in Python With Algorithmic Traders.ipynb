        logging.info(f"Results exported to {filename}")## Performance Analytics and Reportingclass MeanReversionTrader(AlgorithmicTrader):
    def __init__(self, symbol, matching_engine, interval=0.1, lookback=20, 
                 z_score_threshold=2.0, portfolio_manager=None):
        super().__init__(symbol, matching_engine, interval)
        self.lookback = lookback
        self.z_score_threshold = z_score_threshold
        self.prices = []
        self.portfolio_manager = portfolio_manager
        self.position_size = 100
        
    def handle_market_data(self, data):
        self.prices.append(self.current_price)
        if len(self.prices) > self.lookback:
            self.prices.pop(0)
    
    def trade(self):
        if len(self.prices) < self.lookback:
            return
        
        # Calculate mean and standard deviation
        mean_price = np.mean(self.prices)
        std_price = np.std(self.prices)
        
        if std_price == 0:
            return
        
        # Calculate z-score
        z_score = (self.current_price - mean_price) / std_price
        
        # Generate trading signals
        if z_score < -self.z_score_threshold:
            # Price is significantly below mean - buy signal
            order = EnhancedOrder(
                id=f"MR_{random.randint(100000, 999999)}",
                symbol=self.symbol,
                side='buy',
                type=OrderType.LIMIT,
                quantity=self.position_size,
                price=self.current_price * 1.001  # Slight premium to ensure fill
            )
            
            # Add stop loss
            stop_loss = EnhancedOrder(
                id=f"MR_SL_{random.randint(100000, 999999)}",
                symbol=self.symbol,
                side='sell',
                type=OrderType.STOP,
                quantity=self.position_size,
                stop_price=self.current_price * 0.98,  # 2% stop loss
                parent_order_id=order.id
            )
            
            if hasattr(self.matching_engine, 'match_enhanced_order'):
                self.matching_engine.match_enhanced_order(order)
                self.matching_engine.order_book.add_enhanced_order(stop_loss)
            else:
                self.matching_engine.match_order(Order(
                    id=order.id, price=order.price, quantity=order.quantity,
                    side=order.side, type='limit', symbol=order.symbol
                ))
            
            logging.info(f"MeanReversionTrader: Buy signal at z-score {z_score:.2f}")
            
        elif z_score > self.z_score_threshold:
            # Price is significantly above mean - sell signal
            order = EnhancedOrder(
                id=f"MR_{random.randint(100000, 999999)}",
                symbol=self.symbol,
                side='sell',
                type=OrderType.LIMIT,
                quantity=self.position_size,
                price=self.current_price * 0.999  # Slight discount to ensure fill
            )
            
            # Add stop loss
            stop_loss = EnhancedOrder(
                id=f"MR_SL_{random.randint(100000, 999999)}",
                symbol=self.symbol,
                side='buy',
                type=OrderType.STOP,
                quantity=self.position_size,
                stop_price=self.current_price * 1.02,  # 2% stop loss
                parent_order_id=order.id
            )
            
            if hasattr(self.matching_engine, 'match_enhanced_order'):
                self.matching_engine.match_enhanced_order(order)
                self.matching_engine.order_book.add_enhanced_order(stop_loss)
            else:
                self.matching_engine.match_order(Order(
                    id=order.id, price=order.price, quantity=order.quantity,
                    side=order.side, type='limit', symbol=order.symbol
                ))
            
            logging.info(f"MeanReversionTrader: Sell signal at z-score {z_score:.2f}")

class PairsTrader(AlgorithmicTrader):
    def __init__(self, symbol1, symbol2, matching_engine, interval=0.1, 
                 lookback=30, z_score_threshold=2.0, portfolio_manager=None):
        super().__init__(symbol1, matching_engine, interval)
        self.symbol2 = symbol2
        self.lookback = lookback
        self.z_score_threshold = z_score_threshold
        self.price_ratio_history = []
        self.portfolio_manager = portfolio_manager
        self.position_size = 100
        self.symbol1_prices = []
        self.symbol2_prices = []
        
    def handle_market_data(self, data):
        if data['symbol'] == self.symbol:
            self.symbol1_prices.append(data['price'])
            if len(self.symbol1_prices) > self.lookback:
                self.symbol1_prices.pop(0)
        elif data['symbol'] == self.symbol2:
            self.symbol2_prices.append(data['price'])
            if len(self.symbol2_prices) > self.lookback:
                self.symbol2_prices.pop(0)
    
    def trade(self):
        if len(self.symbol1_prices) < self.lookback or len(self.symbol2_prices) < self.lookback:
            return
        
        # Calculate price ratio
        current_ratio = self.symbol1_prices[-1] / self.symbol2_prices[-1]
        self.price_ratio_history.append(current_ratio)
        
        if len(self.price_ratio_history) > self.lookback:
            self.price_ratio_history.pop(0)
        
        if len(self.price_ratio_history) < self.lookback:
            return
        
        # Calculate z-score of the ratio
        mean_ratio = np.mean(self.price_ratio_history)
        std_ratio = np.std(self.price_ratio_history)
        
        if std_ratio == 0:
            return
        
        z_score = (current_ratio - mean_ratio) / std_ratio
        
        # Generate trading signals
        if z_score > self.z_score_threshold:
            # Ratio is high - sell symbol1, buy symbol2
            order1 = EnhancedOrder(
                id=f"PAIR1_{random.randint(100000, 999999)}",
                symbol=self.symbol,
                side='sell',
                type=OrderType.MARKET,
                quantity=self.position_size
            )
            
            order2 = EnhancedOrder(
                id=f"PAIR2_{random.randint(100000, 999999)}",
                symbol=self.symbol2,
                side='buy',
                type=OrderType.MARKET,
                quantity=int(self.position_size * current_ratio)
            )
            
            if hasattr(self.matching_engine, 'match_enhanced_order'):
                self.matching_engine.match_enhanced_order(order1)
                self.matching_engine.match_enhanced_order(order2)
            
            logging.info(f"PairsTrader: Opening pair trade - Short {self.symbol}, Long {self.symbol2}")
            
        elif z_score < -self.z_score_threshold:
            # Ratio is low - buy symbol1, sell symbol2
            order1 = EnhancedOrder(
                id=f"PAIR1_{random.randint(100000, 999999)}",
                symbol=self.symbol,
                side='buy',
                type=OrderType.MARKET,
                quantity=self.position_size
            )
            
            order2 = EnhancedOrder(
                id=f"PAIR2_{random.randint(100000, 999999)}",
                symbol=self.symbol2,
                side='sell',
                type=OrderType.MARKET,
                quantity=int(self.position_size * current_ratio)
            )
            
            if hasattr(self.matching_engine, 'match_enhanced_order'):
                self.matching_engine.match_enhanced_order(order1)
                self.matching_engine.match_enhanced_order(order2)
            
            logging.info(f"PairsTrader: Opening pair trade - Long {self.symbol}, Short {self.symbol2}")

class VWAPTrader(AlgorithmicTrader):
    def __init__(self, symbol, matching_engine, interval=0.1, vwap_period=30,
                 threshold=0.002, portfolio_manager=None):
        super().__init__(symbol, matching_engine, interval)
        self.vwap_period = vwap_period
        self.threshold = threshold
        self.portfolio_manager = portfolio_manager
        self.position_size = 100
        
    def trade(self):
        if not hasattr(self.matching_engine.order_book, 'get_vwap'):
            return
        
        # Calculate VWAP
        vwap = self.matching_engine.order_book.get_vwap(
            self.symbol, 
            timedelta(minutes=self.vwap_period)
        )
        
        if vwap == 0 or self.current_price is None:
            return
        
        # Calculate price deviation from VWAP
        deviation = (self.current_price - vwap) / vwap
        
        # Generate trading signals
        if deviation < -self.threshold:
            # Price below VWAP - buy signal
            order = EnhancedOrder(
                id=f"VWAP_{random.randint(100000, 999999)}",
                symbol=self.symbol,
                side='buy',
                type=OrderType.LIMIT,
                quantity=self.position_size,
                price=self.current_price * 1.001,
                time_in_force="IOC"  # Immediate or cancel
            )
            
            if hasattr(self.matching_engine, 'match_enhanced_order'):
                self.matching_engine.match_enhanced_order(order)
            
            logging.info(f"VWAPTrader: Buy signal - Price {deviation*100:.2f}% below VWAP")
            
        elif deviation > self.threshold:
            # Price above VWAP - sell signal
            order = EnhancedOrder(
                id=f"VWAP_{random.randint(100000, 999999)}",
                symbol=self.symbol,
                side='sell',
                type=OrderType.LIMIT,
                quantity=self.position_size,
                price=self.current_price * 0.999,
                time_in_force="IOC"
            )
            
            if hasattr(self.matching_engine, 'match_enhanced_order'):
                self.matching_engine.match_enhanced_order(order)
            
            logging.info(f"VWAPTrader: Sell signal - Price {deviation*100:.2f}% above VWAP")## Advanced Trading Strategiesclass EnhancedMatchingEngine(MatchingEngine):
    def __init__(self, order_book: EnhancedOrderBook, portfolio_manager: PortfolioManager, 
                 risk_manager: RiskManager):
        super().__init__(order_book)
        self.portfolio_manager = portfolio_manager
        self.risk_manager = risk_manager
        self.commission_rate = 0.001  # 0.1% commission
        self.maker_rebate = 0.0002  # 0.02% maker rebate
        self.taker_fee = 0.003  # 0.3% taker fee
        
    def match_enhanced_order(self, order: EnhancedOrder):
        """Match an enhanced order with risk checks and portfolio updates"""
        # Risk check
        passed, message = self.risk_manager.check_order_risk(order, self.portfolio_manager)
        if not passed:
            order.status = OrderStatus.REJECTED
            logging.warning(f"Order {order.id} rejected: {message}")
            return
        
        # Add order to book
        self.order_book.add_enhanced_order(order)
        
        # Process based on order type
        if order.type == OrderType.MARKET:
            self._match_market_order(order)
        elif order.type == OrderType.LIMIT:
            # Convert to regular order for matching
            regular_order = Order(
                id=order.id,
                price=order.price,
                quantity=order.quantity,
                side=order.side,
                type='limit',
                symbol=order.symbol
            )
            self.match_order(regular_order)
    
    def _match_market_order(self, order: EnhancedOrder):
        """Execute a market order immediately at best available price"""
        if order.side == 'buy':
            while order.quantity - order.filled_quantity > 0 and self.order_book.get_best_ask() is not None:
                best_ask_price = self.order_book.get_best_ask()
                self._execute_enhanced_order(order, best_ask_price, 'sell')
        else:
            while order.quantity - order.filled_quantity > 0 and self.order_book.get_best_bid() is not None:
                best_bid_price = self.order_book.get_best_bid()
                self._execute_enhanced_order(order, best_bid_price, 'buy')
        
        # Update order status
        if order.filled_quantity >= order.quantity:
            order.status = OrderStatus.FILLED
        elif order.filled_quantity > 0:
            order.status = OrderStatus.PARTIALLY_FILLED
    
    def _execute_enhanced_order(self, order: EnhancedOrder, price: float, counter_side: str):
        """Execute orders with portfolio updates"""
        counter_orders = self.order_book.asks if counter_side == 'sell' else self.order_book.bids
        queue = counter_orders.get(price, deque())
        
        while order.quantity - order.filled_quantity > 0 and queue:
            best_order = queue[0]
            
            # Calculate fill quantity
            remaining_quantity = order.quantity - order.filled_quantity
            fill_quantity = min(remaining_quantity, best_order.quantity)
            
            # Calculate commission
            fill_value = fill_quantity * price
            taker_commission = fill_value * self.taker_fee
            maker_rebate = fill_value * self.maker_rebate
            
            # Update portfolios
            if order.side == 'buy':
                # Buyer (taker) pays commission
                self.portfolio_manager.update_position(
                    order.symbol, fill_quantity, price, taker_commission
                )
                # Seller (maker) receives rebate
                # Note: In a real system, you'd update the maker's portfolio
            else:
                # Seller (taker) pays commission
                self.portfolio_manager.update_position(
                    order.symbol, -fill_quantity, price, taker_commission
                )
            
            # Update order states
            order.filled_quantity += fill_quantity
            order.average_fill_price = (
                (order.average_fill_price * (order.filled_quantity - fill_quantity) + 
                 price * fill_quantity) / order.filled_quantity
            )
            order.commission += taker_commission
            
            # Update or remove counter order
            if best_order.quantity > fill_quantity:
                best_order = best_order._replace(quantity=best_order.quantity - fill_quantity)
                self.order_book.modify_order(best_order.id, best_order.quantity)
            else:
                self.order_book.remove_order(best_order.id)
                if queue:
                    queue.popleft()
            
            # Record trade
            triggered_stops = self.order_book.record_trade(
                order.id if order.side == 'buy' else best_order.id,
                best_order.id if order.side == 'buy' else order.id,
                price, fill_quantity, order.symbol
            )
            
            # Process triggered stop orders
            for stop_order in triggered_stops:
                self.match_enhanced_order(stop_order)
            
            # Handle iceberg order refill
            if order.type == OrderType.ICEBERG and 'remaining_hidden' in order.metadata:
                if order.metadata['remaining_hidden'] > 0:
                    refill_quantity = min(
                        order.metadata['visible_quantity'],
                        order.metadata['remaining_hidden']
                    )
                    order.quantity += refill_quantity
                    order.metadata['remaining_hidden'] -= refill_quantity
            
            logging.info(f"Executed trade: {order.symbol} {fill_quantity} @ {price}")
        
        # Update portfolio equity curve
        self.portfolio_manager.equity_curve.append(
            (datetime.now(), self.portfolio_manager.total_value)
        )
        
        # Update risk manager daily stats
        self.risk_manager.update_daily_stats(self.portfolio_manager)## Enhanced Matching Engine with Portfolio Integrationclass EnhancedOrderBook(OrderBook):
    def __init__(self):
        super().__init__()
        self.stop_orders = {}  # Price -> List of stop orders
        self.trailing_stops = []  # List of trailing stop orders
        self.order_history = []  # Historical record of all orders
        self.trade_tape = []  # Record of all executed trades
        self.market_depth_history = []  # Snapshots of market depth
        self.last_trade_price = {}  # Symbol -> Last trade price
        
    def add_enhanced_order(self, order: EnhancedOrder):
        """Add an enhanced order with support for various order types"""
        if order.type == OrderType.STOP or order.type == OrderType.STOP_LIMIT:
            self._add_stop_order(order)
        elif order.type == OrderType.TRAILING_STOP:
            self._add_trailing_stop(order)
        elif order.type == OrderType.ICEBERG:
            self._add_iceberg_order(order)
        else:
            # Convert to regular order for compatibility
            regular_order = Order(
                id=order.id,
                price=order.price,
                quantity=order.quantity,
                side=order.side,
                type='limit' if order.type == OrderType.LIMIT else 'market',
                symbol=order.symbol
            )
            self.add_order(regular_order)
        
        # Record order in history
        self.order_history.append({
            'timestamp': order.timestamp,
            'order': order,
            'action': 'NEW'
        })
    
    def _add_stop_order(self, order: EnhancedOrder):
        """Add a stop order to be triggered at specified price"""
        if order.stop_price not in self.stop_orders:
            self.stop_orders[order.stop_price] = []
        self.stop_orders[order.stop_price].append(order)
    
    def _add_trailing_stop(self, order: EnhancedOrder):
        """Add a trailing stop order"""
        order.metadata['initial_stop_price'] = order.stop_price
        order.metadata['highest_price'] = self.last_trade_price.get(order.symbol, order.stop_price)
        self.trailing_stops.append(order)
    
    def _add_iceberg_order(self, order: EnhancedOrder):
        """Add an iceberg order (only show part of the total quantity)"""
        # Show only the visible portion
        visible_quantity = order.hidden_quantity or order.quantity * 0.1  # Show 10% by default
        visible_order = Order(
            id=order.id,
            price=order.price,
            quantity=visible_quantity,
            side=order.side,
            type='limit',
            symbol=order.symbol
        )
        self.add_order(visible_order)
        
        # Store the hidden portion
        order.metadata['remaining_hidden'] = order.quantity - visible_quantity
        order.metadata['visible_quantity'] = visible_quantity
    
    def check_stop_orders(self, symbol: str, current_price: float):
        """Check and trigger stop orders based on current price"""
        triggered_orders = []
        
        # Check regular stop orders
        for stop_price, orders in list(self.stop_orders.items()):
            remaining_orders = []
            
            for order in orders:
                if order.symbol != symbol:
                    remaining_orders.append(order)
                    continue
                
                # Trigger condition depends on order side
                if ((order.side == 'sell' and current_price <= stop_price) or
                    (order.side == 'buy' and current_price >= stop_price)):
                    
                    # Convert to market or limit order
                    if order.type == OrderType.STOP:
                        # Convert to market order
                        order.type = OrderType.MARKET
                        order.price = current_price
                    else:  # STOP_LIMIT
                        # Convert to limit order
                        order.type = OrderType.LIMIT
                    
                    triggered_orders.append(order)
                    
                    # Record trigger
                    self.order_history.append({
                        'timestamp': datetime.now(),
                        'order': order,
                        'action': 'STOP_TRIGGERED',
                        'trigger_price': current_price
                    })
                else:
                    remaining_orders.append(order)
            
            if remaining_orders:
                self.stop_orders[stop_price] = remaining_orders
            else:
                del self.stop_orders[stop_price]
        
        # Check trailing stops
        remaining_trailing = []
        for order in self.trailing_stops:
            if order.symbol != symbol:
                remaining_trailing.append(order)
                continue
            
            # Update highest/lowest price
            if order.side == 'sell':
                order.metadata['highest_price'] = max(order.metadata['highest_price'], current_price)
                new_stop_price = order.metadata['highest_price'] - order.trailing_amount
                
                if current_price <= new_stop_price:
                    order.type = OrderType.MARKET
                    order.price = current_price
                    triggered_orders.append(order)
                else:
                    order.stop_price = new_stop_price
                    remaining_trailing.append(order)
            else:  # buy
                order.metadata['lowest_price'] = min(order.metadata.get('lowest_price', current_price), current_price)
                new_stop_price = order.metadata['lowest_price'] + order.trailing_amount
                
                if current_price >= new_stop_price:
                    order.type = OrderType.MARKET
                    order.price = current_price
                    triggered_orders.append(order)
                else:
                    order.stop_price = new_stop_price
                    remaining_trailing.append(order)
        
        self.trailing_stops = remaining_trailing
        
        return triggered_orders
    
    def record_trade(self, buyer_order_id: str, seller_order_id: str, 
                    price: float, quantity: float, symbol: str):
        """Record an executed trade"""
        trade = {
            'timestamp': datetime.now(),
            'buyer_order_id': buyer_order_id,
            'seller_order_id': seller_order_id,
            'price': price,
            'quantity': quantity,
            'symbol': symbol,
            'trade_id': f"{buyer_order_id}_{seller_order_id}_{datetime.now().timestamp()}"
        }
        self.trade_tape.append(trade)
        self.last_trade_price[symbol] = price
        
        # Check for stop order triggers
        triggered_stops = self.check_stop_orders(symbol, price)
        
        return triggered_stops
    
    def get_market_depth(self, symbol: str, levels: int = 5) -> Dict:
        """Get market depth for a symbol"""
        bid_depth = []
        ask_depth = []
        
        # Get bid depth
        bid_prices = sorted([p for p in self.bids.keys()], reverse=True)
        for i, price in enumerate(bid_prices[:levels]):
            total_quantity = sum(order.quantity for order in self.bids[price] if order.symbol == symbol)
            if total_quantity > 0:
                bid_depth.append({
                    'price': price,
                    'quantity': total_quantity,
                    'orders': len([o for o in self.bids[price] if o.symbol == symbol])
                })
        
        # Get ask depth
        ask_prices = sorted([p for p in self.asks.keys()])
        for i, price in enumerate(ask_prices[:levels]):
            total_quantity = sum(order.quantity for order in self.asks[price] if order.symbol == symbol)
            if total_quantity > 0:
                ask_depth.append({
                    'price': price,
                    'quantity': total_quantity,
                    'orders': len([o for o in self.asks[price] if o.symbol == symbol])
                })
        
        depth = {
            'symbol': symbol,
            'timestamp': datetime.now(),
            'bids': bid_depth,
            'asks': ask_depth,
            'spread': ask_depth[0]['price'] - bid_depth[0]['price'] if bid_depth and ask_depth else None,
            'mid_price': (ask_depth[0]['price'] + bid_depth[0]['price']) / 2 if bid_depth and ask_depth else None
        }
        
        # Record depth snapshot
        self.market_depth_history.append(depth)
        
        return depth
    
    def get_order_book_imbalance(self, symbol: str) -> float:
        """Calculate order book imbalance (-1 to 1, negative = more sells)"""
        bid_volume = sum(
            order.quantity for price_orders in self.bids.values() 
            for order in price_orders if order.symbol == symbol
        )
        ask_volume = sum(
            order.quantity for price_orders in self.asks.values() 
            for order in price_orders if order.symbol == symbol
        )
        
        total_volume = bid_volume + ask_volume
        if total_volume == 0:
            return 0
        
        return (bid_volume - ask_volume) / total_volume
    
    def get_vwap(self, symbol: str, time_window: timedelta = timedelta(minutes=5)) -> float:
        """Calculate Volume Weighted Average Price"""
        cutoff_time = datetime.now() - time_window
        relevant_trades = [
            t for t in self.trade_tape 
            if t['symbol'] == symbol and t['timestamp'] > cutoff_time
        ]
        
        if not relevant_trades:
            return self.last_trade_price.get(symbol, 0)
        
        total_value = sum(t['price'] * t['quantity'] for t in relevant_trades)
        total_volume = sum(t['quantity'] for t in relevant_trades)
        
        return total_value / total_volume if total_volume > 0 else 0## Enhanced Order Book with Advanced Featuresclass MarketEventType(Enum):
    VOLATILITY_SPIKE = "volatility_spike"
    FLASH_CRASH = "flash_crash"
    CIRCUIT_BREAKER = "circuit_breaker"
    LIQUIDITY_CRISIS = "liquidity_crisis"
    NEWS_SHOCK = "news_shock"
    MARKET_OPEN = "market_open"
    MARKET_CLOSE = "market_close"
    EARNINGS_ANNOUNCEMENT = "earnings_announcement"

@dataclass
class MarketEvent:
    event_type: MarketEventType
    timestamp: datetime
    duration: timedelta
    magnitude: float  # Impact magnitude (0-1)
    affected_symbols: List[str]
    metadata: Dict = field(default_factory=dict)

class MarketEventSimulator:
    def __init__(self):
        self.active_events: List[MarketEvent] = []
        self.event_history: List[MarketEvent] = []
        self.event_handlers = {
            MarketEventType.VOLATILITY_SPIKE: self._handle_volatility_spike,
            MarketEventType.FLASH_CRASH: self._handle_flash_crash,
            MarketEventType.CIRCUIT_BREAKER: self._handle_circuit_breaker,
            MarketEventType.LIQUIDITY_CRISIS: self._handle_liquidity_crisis,
            MarketEventType.NEWS_SHOCK: self._handle_news_shock,
            MarketEventType.EARNINGS_ANNOUNCEMENT: self._handle_earnings_announcement
        }
        
    def simulate_event(self, event: MarketEvent, market_data: Dict[str, float], 
                      order_book: OrderBook) -> Dict[str, float]:
        """Simulate a market event and return adjusted market prices"""
        self.active_events.append(event)
        self.event_history.append(event)
        
        # Apply event handler
        handler = self.event_handlers.get(event.event_type)
        if handler:
            adjusted_prices = handler(event, market_data, order_book)
        else:
            adjusted_prices = market_data.copy()
        
        # Log event
        logging.info(f"Market event triggered: {event.event_type.value} "
                    f"affecting {event.affected_symbols} with magnitude {event.magnitude}")
        
        return adjusted_prices
    
    def _handle_volatility_spike(self, event: MarketEvent, market_data: Dict[str, float], 
                                order_book: OrderBook) -> Dict[str, float]:
        """Simulate increased volatility"""
        adjusted_prices = market_data.copy()
        
        for symbol in event.affected_symbols:
            if symbol in adjusted_prices:
                # Increase price movement
                random_factor = np.random.normal(0, event.magnitude * 0.05)
                adjusted_prices[symbol] *= (1 + random_factor)
                
                # Widen bid-ask spread
                self._widen_spread(order_book, symbol, event.magnitude)
        
        return adjusted_prices
    
    def _handle_flash_crash(self, event: MarketEvent, market_data: Dict[str, float], 
                           order_book: OrderBook) -> Dict[str, float]:
        """Simulate a flash crash"""
        adjusted_prices = market_data.copy()
        
        for symbol in event.affected_symbols:
            if symbol in adjusted_prices:
                # Sharp price drop
                crash_magnitude = event.magnitude * 0.1  # Up to 10% drop
                adjusted_prices[symbol] *= (1 - crash_magnitude)
                
                # Cancel a portion of buy orders
                self._cancel_orders(order_book, symbol, 'buy', event.magnitude * 0.5)
        
        return adjusted_prices
    
    def _handle_circuit_breaker(self, event: MarketEvent, market_data: Dict[str, float], 
                               order_book: OrderBook) -> Dict[str, float]:
        """Simulate a circuit breaker halt"""
        # Cancel all orders for affected symbols
        for symbol in event.affected_symbols:
            self._halt_trading(order_book, symbol)
        
        # Prices remain unchanged during halt
        return market_data.copy()
    
    def _handle_liquidity_crisis(self, event: MarketEvent, market_data: Dict[str, float], 
                                order_book: OrderBook) -> Dict[str, float]:
        """Simulate a liquidity crisis"""
        adjusted_prices = market_data.copy()
        
        for symbol in event.affected_symbols:
            # Reduce order book depth
            self._reduce_liquidity(order_book, symbol, event.magnitude)
            
            # Increase volatility
            if symbol in adjusted_prices:
                random_factor = np.random.normal(0, event.magnitude * 0.03)
                adjusted_prices[symbol] *= (1 + random_factor)
        
        return adjusted_prices
    
    def _handle_news_shock(self, event: MarketEvent, market_data: Dict[str, float], 
                          order_book: OrderBook) -> Dict[str, float]:
        """Simulate a news-driven price shock"""
        adjusted_prices = market_data.copy()
        
        # Positive or negative news
        direction = event.metadata.get('direction', 1)  # 1 for positive, -1 for negative
        
        for symbol in event.affected_symbols:
            if symbol in adjusted_prices:
                shock_magnitude = event.magnitude * 0.05 * direction
                adjusted_prices[symbol] *= (1 + shock_magnitude)
        
        return adjusted_prices
    
    def _handle_earnings_announcement(self, event: MarketEvent, market_data: Dict[str, float], 
                                     order_book: OrderBook) -> Dict[str, float]:
        """Simulate earnings announcement impact"""
        adjusted_prices = market_data.copy()
        
        # Earnings surprise
        surprise = event.metadata.get('earnings_surprise', 0)  # Percentage surprise
        
        for symbol in event.affected_symbols:
            if symbol in adjusted_prices:
                # Price adjustment based on earnings surprise
                price_impact = surprise * event.magnitude * 0.01
                adjusted_prices[symbol] *= (1 + price_impact)
                
                # Increase trading volume (simulate by adding synthetic orders)
                self._increase_volume(order_book, symbol, event.magnitude)
        
        return adjusted_prices
    
    def _widen_spread(self, order_book: OrderBook, symbol: str, magnitude: float):
        """Widen bid-ask spread during volatile conditions"""
        # Cancel orders near the spread
        best_bid = order_book.get_best_bid()
        best_ask = order_book.get_best_ask()
        
        if best_bid and best_ask:
            spread = best_ask - best_bid
            new_spread = spread * (1 + magnitude)
            
            # Cancel orders within the new spread range
            for price_level in list(order_book.bids.keys()):
                if price_level > best_bid - (new_spread - spread) / 2:
                    for order in list(order_book.bids[price_level]):
                        if order.symbol == symbol:
                            order_book.remove_order(order.id)
            
            for price_level in list(order_book.asks.keys()):
                if price_level < best_ask + (new_spread - spread) / 2:
                    for order in list(order_book.asks[price_level]):
                        if order.symbol == symbol:
                            order_book.remove_order(order.id)
    
    def _cancel_orders(self, order_book: OrderBook, symbol: str, side: str, percentage: float):
        """Cancel a percentage of orders on one side"""
        orders_to_cancel = []
        
        if side == 'buy':
            for price_level, orders in order_book.bids.items():
                for order in orders:
                    if order.symbol == symbol and random.random() < percentage:
                        orders_to_cancel.append(order.id)
        else:
            for price_level, orders in order_book.asks.items():
                for order in orders:
                    if order.symbol == symbol and random.random() < percentage:
                        orders_to_cancel.append(order.id)
        
        for order_id in orders_to_cancel:
            order_book.remove_order(order_id)
    
    def _halt_trading(self, order_book: OrderBook, symbol: str):
        """Halt trading for a symbol by canceling all orders"""
        orders_to_cancel = []
        
        for order_id, order in order_book.order_map.items():
            if order.symbol == symbol:
                orders_to_cancel.append(order_id)
        
        for order_id in orders_to_cancel:
            order_book.remove_order(order_id)
    
    def _reduce_liquidity(self, order_book: OrderBook, symbol: str, magnitude: float):
        """Reduce liquidity by canceling orders"""
        self._cancel_orders(order_book, symbol, 'buy', magnitude * 0.3)
        self._cancel_orders(order_book, symbol, 'sell', magnitude * 0.3)
    
    def _increase_volume(self, order_book: OrderBook, symbol: str, magnitude: float):
        """Simulate increased trading volume"""
        # This would typically trigger more order generation from market participants
        # For simulation purposes, we'll just log this
        logging.info(f"Trading volume increased for {symbol} by {magnitude * 100}%")
    
    def cleanup_expired_events(self):
        """Remove expired events from active list"""
        current_time = datetime.now()
        self.active_events = [
            event for event in self.active_events 
            if current_time < event.timestamp + event.duration
        ]
    
    def get_active_events(self) -> List[MarketEvent]:
        """Get list of currently active events"""
        self.cleanup_expired_events()
        return self.active_events.copy()## Market Event Simulatorclass RiskManager:
    def __init__(self, 
                 max_position_size: float = 10000,
                 max_portfolio_risk: float = 0.02,  # 2% max risk per trade
                 max_daily_loss: float = 0.05,      # 5% max daily loss
                 max_leverage: float = 2.0,
                 position_limits: Dict[str, float] = None):
        self.max_position_size = max_position_size
        self.max_portfolio_risk = max_portfolio_risk
        self.max_daily_loss = max_daily_loss
        self.max_leverage = max_leverage
        self.position_limits = position_limits or {}
        self.daily_pnl = 0
        self.start_of_day_value = 0
        
    def check_order_risk(self, order: EnhancedOrder, portfolio: PortfolioManager) -> Tuple[bool, str]:
        """Check if an order passes risk controls"""
        # Check position size limit
        if order.quantity * order.price > self.max_position_size:
            return False, "Order exceeds maximum position size"
        
        # Check symbol-specific position limits
        if order.symbol in self.position_limits:
            current_position = portfolio.positions.get(order.symbol, None)
            current_quantity = current_position.quantity if current_position else 0
            
            if order.side == 'buy':
                new_quantity = current_quantity + order.quantity
            else:
                new_quantity = current_quantity - order.quantity
            
            if abs(new_quantity) > self.position_limits[order.symbol]:
                return False, f"Order would exceed position limit for {order.symbol}"
        
        # Check leverage
        total_exposure = sum(abs(pos.market_value) for pos in portfolio.positions.values())
        new_exposure = total_exposure + (order.quantity * order.price)
        
        if new_exposure > portfolio.total_value * self.max_leverage:
            return False, "Order would exceed maximum leverage"
        
        # Check daily loss limit
        current_daily_loss = (self.start_of_day_value - portfolio.total_value) / self.start_of_day_value
        if current_daily_loss > self.max_daily_loss:
            return False, "Daily loss limit reached"
        
        # Check portfolio risk (simplified Kelly criterion)
        position_risk = self._calculate_position_risk(order, portfolio)
        if position_risk > self.max_portfolio_risk * portfolio.total_value:
            return False, "Order exceeds maximum portfolio risk"
        
        return True, "Order passed risk checks"
    
    def _calculate_position_risk(self, order: EnhancedOrder, portfolio: PortfolioManager) -> float:
        """Calculate risk for a position based on volatility"""
        # Simplified risk calculation - in practice, use historical volatility
        # Assume 2% daily volatility as default
        volatility = 0.02
        position_value = order.quantity * order.price
        return position_value * volatility
    
    def update_daily_stats(self, portfolio: PortfolioManager):
        """Update daily statistics for risk monitoring"""
        self.daily_pnl = portfolio.total_value - self.start_of_day_value
        
    def reset_daily_stats(self, portfolio: PortfolioManager):
        """Reset daily statistics at start of trading day"""
        self.start_of_day_value = portfolio.total_value
        self.daily_pnl = 0
        
    def calculate_var(self, portfolio: PortfolioManager, confidence_level: float = 0.95, 
                     time_horizon: int = 1) -> float:
        """Calculate Value at Risk (VaR)"""
        # Simplified VaR calculation
        portfolio_value = portfolio.total_value
        portfolio_volatility = 0.02  # Assume 2% daily volatility
        
        # Calculate VaR using normal distribution
        z_score = stats.norm.ppf(1 - confidence_level)
        var = portfolio_value * portfolio_volatility * np.sqrt(time_horizon) * abs(z_score)
        
        return var
    
    def get_risk_metrics(self, portfolio: PortfolioManager) -> Dict:
        """Get comprehensive risk metrics"""
        total_exposure = sum(abs(pos.market_value) for pos in portfolio.positions.values())
        
        return {
            'current_leverage': total_exposure / portfolio.total_value if portfolio.total_value > 0 else 0,
            'daily_pnl': self.daily_pnl,
            'daily_pnl_pct': self.daily_pnl / self.start_of_day_value * 100 if self.start_of_day_value > 0 else 0,
            'var_95': self.calculate_var(portfolio, 0.95),
            'var_99': self.calculate_var(portfolio, 0.99),
            'number_of_positions': len(portfolio.positions),
            'largest_position': max([abs(pos.market_value) for pos in portfolio.positions.values()]) if portfolio.positions else 0,
            'concentration_risk': self._calculate_concentration_risk(portfolio)
        }
    
    def _calculate_concentration_risk(self, portfolio: PortfolioManager) -> float:
        """Calculate Herfindahl-Hirschman Index for concentration risk"""
        if not portfolio.positions:
            return 0
        
        total_exposure = sum(abs(pos.market_value) for pos in portfolio.positions.values())
        if total_exposure == 0:
            return 0
        
        hhi = sum((abs(pos.market_value) / total_exposure) ** 2 for pos in portfolio.positions.values())
        return hhi## Risk Management Module@dataclass
class Position:
    symbol: str
    quantity: float
    average_price: float
    current_price: float
    timestamp: datetime = field(default_factory=datetime.now)
    
    @property
    def market_value(self) -> float:
        return self.quantity * self.current_price
    
    @property
    def unrealized_pnl(self) -> float:
        return (self.current_price - self.average_price) * self.quantity
    
    @property
    def unrealized_pnl_pct(self) -> float:
        if self.average_price == 0:
            return 0
        return (self.unrealized_pnl / (self.average_price * abs(self.quantity))) * 100

class PortfolioManager:
    def __init__(self, initial_capital: float = 100000):
        self.initial_capital = initial_capital
        self.cash = initial_capital
        self.positions: Dict[str, Position] = {}
        self.transaction_history: List[Dict] = []
        self.equity_curve: List[Tuple[datetime, float]] = [(datetime.now(), initial_capital)]
        self.realized_pnl = 0
        self.commission_paid = 0
        
    def update_position(self, symbol: str, quantity: float, price: float, commission: float = 0):
        """Update position after a trade execution"""
        if symbol in self.positions:
            pos = self.positions[symbol]
            # Calculate new average price
            if (pos.quantity > 0 and quantity > 0) or (pos.quantity < 0 and quantity < 0):
                # Adding to position
                total_value = pos.quantity * pos.average_price + quantity * price
                pos.quantity += quantity
                pos.average_price = total_value / pos.quantity if pos.quantity != 0 else 0
            else:
                # Reducing or closing position
                if abs(quantity) >= abs(pos.quantity):
                    # Position closed or reversed
                    realized_pnl = (price - pos.average_price) * min(abs(quantity), abs(pos.quantity))
                    if pos.quantity > 0:
                        self.realized_pnl += realized_pnl
                    else:
                        self.realized_pnl -= realized_pnl
                    
                    if abs(quantity) > abs(pos.quantity):
                        # Position reversed
                        pos.quantity = quantity + pos.quantity
                        pos.average_price = price
                    else:
                        # Position closed
                        del self.positions[symbol]
                else:
                    # Partial close
                    realized_pnl = (price - pos.average_price) * abs(quantity)
                    if pos.quantity > 0:
                        self.realized_pnl += realized_pnl
                    else:
                        self.realized_pnl -= realized_pnl
                    pos.quantity += quantity
        else:
            # New position
            self.positions[symbol] = Position(symbol, quantity, price, price)
        
        # Update cash
        self.cash -= quantity * price + commission
        self.commission_paid += commission
        
        # Record transaction
        self.transaction_history.append({
            'timestamp': datetime.now(),
            'symbol': symbol,
            'quantity': quantity,
            'price': price,
            'commission': commission,
            'cash_balance': self.cash
        })
    
    def update_market_prices(self, market_prices: Dict[str, float]):
        """Update current market prices for all positions"""
        for symbol, position in self.positions.items():
            if symbol in market_prices:
                position.current_price = market_prices[symbol]
    
    @property
    def total_value(self) -> float:
        """Calculate total portfolio value"""
        positions_value = sum(pos.market_value for pos in self.positions.values())
        return self.cash + positions_value
    
    @property
    def unrealized_pnl(self) -> float:
        """Calculate total unrealized P&L"""
        return sum(pos.unrealized_pnl for pos in self.positions.values())
    
    @property
    def total_pnl(self) -> float:
        """Calculate total P&L (realized + unrealized)"""
        return self.realized_pnl + self.unrealized_pnl
    
    def get_performance_metrics(self) -> Dict:
        """Calculate comprehensive performance metrics"""
        if not self.equity_curve:
            return {}
        
        returns = []
        for i in range(1, len(self.equity_curve)):
            prev_value = self.equity_curve[i-1][1]
            curr_value = self.equity_curve[i][1]
            if prev_value != 0:
                returns.append((curr_value - prev_value) / prev_value)
        
        if not returns:
            returns = [0]
        
        return {
            'total_return': (self.total_value - self.initial_capital) / self.initial_capital * 100,
            'realized_pnl': self.realized_pnl,
            'unrealized_pnl': self.unrealized_pnl,
            'total_pnl': self.total_pnl,
            'win_rate': self._calculate_win_rate(),
            'sharpe_ratio': self._calculate_sharpe_ratio(returns),
            'max_drawdown': self._calculate_max_drawdown(),
            'commission_paid': self.commission_paid,
            'number_of_trades': len(self.transaction_history),
            'current_positions': len(self.positions)
        }
    
    def _calculate_win_rate(self) -> float:
        """Calculate percentage of winning trades"""
        winning_trades = 0
        total_trades = 0
        
        # Group transactions by symbol to identify completed trades
        symbol_trades = {}
        for tx in self.transaction_history:
            symbol = tx['symbol']
            if symbol not in symbol_trades:
                symbol_trades[symbol] = []
            symbol_trades[symbol].append(tx)
        
        # Calculate P&L for completed trades
        for symbol, trades in symbol_trades.items():
            position = 0
            entry_price = 0
            
            for trade in trades:
                if position == 0:
                    # New position
                    position = trade['quantity']
                    entry_price = trade['price']
                elif (position > 0 and trade['quantity'] < 0) or (position < 0 and trade['quantity'] > 0):
                    # Closing trade
                    pnl = (trade['price'] - entry_price) * min(abs(trade['quantity']), abs(position))
                    if position < 0:
                        pnl = -pnl
                    
                    if pnl > 0:
                        winning_trades += 1
                    total_trades += 1
                    
                    position += trade['quantity']
                    if position != 0:
                        entry_price = trade['price']
                else:
                    # Adding to position
                    total_value = position * entry_price + trade['quantity'] * trade['price']
                    position += trade['quantity']
                    entry_price = total_value / position if position != 0 else 0
        
        return winning_trades / total_trades * 100 if total_trades > 0 else 0
    
    def _calculate_sharpe_ratio(self, returns: List[float], risk_free_rate: float = 0.02) -> float:
        """Calculate Sharpe ratio"""
        if not returns:
            return 0
        
        # Annualize returns assuming daily data
        periods_per_year = 252
        avg_return = np.mean(returns) * periods_per_year
        std_return = np.std(returns) * np.sqrt(periods_per_year)
        
        if std_return == 0:
            return 0
        
        return (avg_return - risk_free_rate) / std_return
    
    def _calculate_max_drawdown(self) -> float:
        """Calculate maximum drawdown percentage"""
        if len(self.equity_curve) < 2:
            return 0
        
        values = [ec[1] for ec in self.equity_curve]
        peak = values[0]
        max_dd = 0
        
        for value in values[1:]:
            if value > peak:
                peak = value
            dd = (peak - value) / peak * 100
            max_dd = max(max_dd, dd)
        
        return max_dd## Position Tracking and Portfolio Management# Enhanced Order Types
class OrderType(Enum):
    MARKET = "market"
    LIMIT = "limit"
    STOP = "stop"
    STOP_LIMIT = "stop_limit"
    TRAILING_STOP = "trailing_stop"
    ICEBERG = "iceberg"

class OrderStatus(Enum):
    NEW = "new"
    PARTIALLY_FILLED = "partially_filled"
    FILLED = "filled"
    CANCELLED = "cancelled"
    REJECTED = "rejected"
    EXPIRED = "expired"

@dataclass
class EnhancedOrder:
    id: str
    symbol: str
    side: str  # 'buy' or 'sell'
    type: OrderType
    quantity: float
    price: Optional[float] = None
    stop_price: Optional[float] = None
    trailing_amount: Optional[float] = None
    time_in_force: str = "GTC"  # Good Till Cancelled, IOC, FOK, etc.
    timestamp: datetime = field(default_factory=datetime.now)
    status: OrderStatus = OrderStatus.NEW
    filled_quantity: float = 0
    average_fill_price: float = 0
    commission: float = 0
    hidden_quantity: Optional[float] = None  # For iceberg orders
    parent_order_id: Optional[str] = None  # For linked orders
    metadata: Dict = field(default_factory=dict)## Enhanced Order Types and Data Structures# Additional imports for enhanced functionality
