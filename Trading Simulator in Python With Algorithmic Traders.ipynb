    return stress_results## Comprehensive Integration and Usage Examplesclass DataManager:
    """Manages historical data storage, retrieval, and analysis."""
    
    def __init__(self, data_path: str = "trading_data/"):
        self.data_path = data_path
        os.makedirs(data_path, exist_ok=True)
        
    def download_and_store_data(self, symbols: List[str], start_date: str, 
                               end_date: str, interval: str = "1d") -> Dict[str, pd.DataFrame]:
        """Download and store historical data for multiple symbols."""
        data_dict = {}
        
        for symbol in symbols:
            try:
                data = yf.download(symbol, start=start_date, end=end_date, interval=interval)
                data.reset_index(inplace=True)
                
                # Store to file
                filename = f"{self.data_path}{symbol}_{interval}_{start_date}_{end_date}.csv"
                data.to_csv(filename, index=False)
                
                data_dict[symbol] = data
                logging.info(f"Downloaded and stored data for {symbol}")
                
            except Exception as e:
                logging.error(f"Failed to download data for {symbol}: {e}")
                
        return data_dict
    
    def load_stored_data(self, symbol: str, start_date: str, end_date: str, 
                        interval: str = "1d") -> pd.DataFrame:
        """Load previously stored data."""
        filename = f"{self.data_path}{symbol}_{interval}_{start_date}_{end_date}.csv"
        
        if os.path.exists(filename):
            return pd.read_csv(filename, parse_dates=['Date'])
        else:
            # Download if not stored
            data = yf.download(symbol, start=start_date, end=end_date, interval=interval)
            data.reset_index(inplace=True)
            data.to_csv(filename, index=False)
            return data
    
    def create_market_replay(self, symbol: str, start_date: str, end_date: str, 
                           speed_multiplier: float = 1.0) -> Generator:
        """Create a market data replay generator."""
        data = self.load_stored_data(symbol, start_date, end_date)
        
        for index, row in data.iterrows():
            market_data = {
                'symbol': symbol,
                'timestamp': row['Date'],
                'open': row['Open'],
                'high': row['High'],
                'low': row['Low'],
                'close': row['Close'],
                'volume': row['Volume']
            }
            
            yield market_data
            
            # Control replay speed
            if speed_multiplier > 0:
                time.sleep(1.0 / speed_multiplier)

class PerformanceAnalyzer:
    """Advanced performance analysis and visualization."""
    
    def __init__(self):
        plt.style.use('seaborn-v0_8')
        
    def create_comprehensive_report(self, portfolio: Portfolio, 
                                  benchmark_symbol: str = "SPY") -> Dict:
        """Create a comprehensive performance report."""
        metrics = portfolio.get_performance_metrics()
        
        # Get benchmark data
        benchmark_data = yf.download(benchmark_symbol, 
                                   start=portfolio.trade_history[0]['timestamp'] if portfolio.trade_history else datetime.now() - timedelta(days=365),
                                   end=portfolio.trade_history[-1]['timestamp'] if portfolio.trade_history else datetime.now())
        
        benchmark_returns = benchmark_data['Close'].pct_change().dropna().tolist()
        
        # Calculate additional metrics
        metrics['alpha'] = self.calculate_alpha(portfolio.returns, benchmark_returns)
        metrics['beta'] = self.calculate_beta(portfolio.returns, benchmark_returns)
        metrics['information_ratio'] = self.calculate_information_ratio(portfolio.returns, benchmark_returns)
        metrics['sortino_ratio'] = self.calculate_sortino_ratio(portfolio.returns)
        
        return metrics
    
    def calculate_alpha(self, portfolio_returns: List[float], 
                       benchmark_returns: List[float], risk_free_rate: float = 0.02) -> float:
        """Calculate Jensen's Alpha."""
        if len(portfolio_returns) != len(benchmark_returns) or len(portfolio_returns) < 2:
            return 0.0
            
        portfolio_returns = np.array(portfolio_returns)
        benchmark_returns = np.array(benchmark_returns)
        
        # Excess returns
        portfolio_excess = portfolio_returns - risk_free_rate / 252
        benchmark_excess = benchmark_returns - risk_free_rate / 252
        
        # Calculate beta
        beta = np.cov(portfolio_excess, benchmark_excess)[0, 1] / np.var(benchmark_excess)
        
        # Alpha = Portfolio Return - (Risk Free Rate + Beta * (Benchmark Return - Risk Free Rate))
        alpha = np.mean(portfolio_excess) - beta * np.mean(benchmark_excess)
        
        return alpha * 252  # Annualize
    
    def calculate_beta(self, portfolio_returns: List[float], 
                      benchmark_returns: List[float]) -> float:
        """Calculate portfolio beta."""
        if len(portfolio_returns) != len(benchmark_returns) or len(portfolio_returns) < 2:
            return 1.0
            
        return np.cov(portfolio_returns, benchmark_returns)[0, 1] / np.var(benchmark_returns)
    
    def calculate_information_ratio(self, portfolio_returns: List[float], 
                                   benchmark_returns: List[float]) -> float:
        """Calculate Information Ratio."""
        if len(portfolio_returns) != len(benchmark_returns) or len(portfolio_returns) < 2:
            return 0.0
            
        excess_returns = np.array(portfolio_returns) - np.array(benchmark_returns)
        return np.mean(excess_returns) / np.std(excess_returns) * np.sqrt(252) if np.std(excess_returns) > 0 else 0.0
    
    def calculate_sortino_ratio(self, returns: List[float], risk_free_rate: float = 0.02) -> float:
        """Calculate Sortino Ratio (uses downside deviation instead of total volatility)."""
        if len(returns) < 2:
            return 0.0
            
        excess_returns = np.array(returns) - risk_free_rate / 252
        downside_returns = excess_returns[excess_returns < 0]
        
        if len(downside_returns) == 0:
            return float('inf')
            
        downside_deviation = np.std(downside_returns)
        return np.mean(excess_returns) / downside_deviation * np.sqrt(252) if downside_deviation > 0 else 0.0
    
