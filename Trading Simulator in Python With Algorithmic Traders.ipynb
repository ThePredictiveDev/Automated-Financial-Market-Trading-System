    return simulatorclass TradingSimulator:
    """
    Comprehensive Trading Simulator that integrates all components
    """
    def __init__(self, initial_capital: float = 100000, mode: str = 'live'):
        """
        Initialize the trading simulator
        
        Args:
            initial_capital: Starting capital
            mode: 'live' for real-time simulation or 'backtest' for historical
        """
        self.mode = mode
        self.initial_capital = initial_capital
        
        # Core components
        self.portfolio_manager = PortfolioManager(initial_capital)
        self.order_book = EnhancedOrderBook()
        self.risk_manager = RiskManager(
            max_position_size=initial_capital * 0.1,  # 10% max per position
            max_portfolio_risk=0.02,
            max_daily_loss=0.05,
            max_leverage=2.0
        )
        self.matching_engine = EnhancedMatchingEngine(
            self.order_book, self.portfolio_manager, self.risk_manager
        )
        self.market_event_simulator = MarketEventSimulator()
        self.performance_analyzer = PerformanceAnalyzer(
            self.portfolio_manager, self.order_book
        )
        
        # Traders
        self.traders = {}
        self.active_traders = []
        
        # Market data
        self.market_data_feeds = {}
        self.current_prices = {}
        
        # Control flags
        self.running = False
        self.threads = []
        
        # Logging
        self.setup_logging()
        
    def setup_logging(self):
        """Configure logging with custom format"""
        logging.basicConfig(
            level=logging.INFO,
            format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
            handlers=[
                logging.FileHandler('trading_simulator.log'),
                logging.StreamHandler()
            ]
        )
    
    def add_symbol(self, symbol: str):
        """Add a symbol to track"""
        if self.mode == 'live':
            feed = MarketDataFeed(symbol)
            self.market_data_feeds[symbol] = feed
        self.current_prices[symbol] = 0
    
    def create_trader(self, trader_type: str, **kwargs) -> AlgorithmicTrader:
        """Factory method to create traders"""
        trader_map = {
            'momentum': MomentumTrader,
            'ema': EMABasedTrader,
            'swing': SwingTrader,
            'mean_reversion': MeanReversionTrader,
            'pairs': PairsTrader,
            'vwap': VWAPTrader,
            'market_maker': MarketMaker
        }
        
        if trader_type not in trader_map:
            raise ValueError(f"Unknown trader type: {trader_type}")
        
        # Set default matching engine
        if 'matching_engine' not in kwargs:
            kwargs['matching_engine'] = self.matching_engine
        
        # Set portfolio manager if applicable
        if 'portfolio_manager' not in kwargs and trader_type in ['mean_reversion', 'pairs', 'vwap']:
            kwargs['portfolio_manager'] = self.portfolio_manager
        
        trader = trader_map[trader_type](**kwargs)
        
        # Generate unique ID
        trader_id = f"{trader_type}_{len(self.traders)}"
        self.traders[trader_id] = trader
        
        return trader
    
    def activate_trader(self, trader_id: str):
        """Activate a trader"""
        if trader_id in self.traders and trader_id not in self.active_traders:
            self.active_traders.append(trader_id)
            logging.info(f"Activated trader: {trader_id}")
    
    def deactivate_trader(self, trader_id: str):
        """Deactivate a trader"""
        if trader_id in self.active_traders:
            self.active_traders.remove(trader_id)
            logging.info(f"Deactivated trader: {trader_id}")
    
    def simulate_market_event(self, event_type: str, symbols: List[str], 
                            magnitude: float = 0.5, duration_minutes: int = 30):
        """Manually trigger a market event"""
        event = MarketEvent(
            event_type=MarketEventType[event_type.upper()],
            timestamp=datetime.now(),
            duration=timedelta(minutes=duration_minutes),
            magnitude=magnitude,
            affected_symbols=symbols,
            metadata={}
        )
        
        adjusted_prices = self.market_event_simulator.simulate_event(
            event, self.current_prices, self.order_book
        )
        self.current_prices.update(adjusted_prices)
    
    def place_manual_order(self, symbol: str, side: str, order_type: str, 
                          quantity: float, price: float = None, 
                          stop_price: float = None) -> str:
        """Place a manual order"""
        order_id = f"MANUAL_{random.randint(100000, 999999)}"
        
        order = EnhancedOrder(
            id=order_id,
            symbol=symbol,
            side=side,
            type=OrderType[order_type.upper()],
            quantity=quantity,
            price=price,
            stop_price=stop_price
        )
        
        self.matching_engine.match_enhanced_order(order)
        return order_id
    
    def get_portfolio_summary(self) -> Dict:
        """Get current portfolio status"""
        return {
            'total_value': self.portfolio_manager.total_value,
            'cash': self.portfolio_manager.cash,
            'positions': {
                symbol: {
                    'quantity': pos.quantity,
                    'average_price': pos.average_price,
                    'current_price': pos.current_price,
                    'market_value': pos.market_value,
                    'unrealized_pnl': pos.unrealized_pnl,
                    'unrealized_pnl_pct': pos.unrealized_pnl_pct
                }
                for symbol, pos in self.portfolio_manager.positions.items()
            },
            'realized_pnl': self.portfolio_manager.realized_pnl,
            'total_pnl': self.portfolio_manager.total_pnl,
            'commission_paid': self.portfolio_manager.commission_paid
        }
    
    def get_risk_metrics(self) -> Dict:
        """Get current risk metrics"""
        return self.risk_manager.get_risk_metrics(self.portfolio_manager)
    
    def get_market_depth(self, symbol: str, levels: int = 5) -> Dict:
        """Get order book depth for a symbol"""
        return self.order_book.get_market_depth(symbol, levels)
    
    def start(self):
        """Start the live trading simulator"""
        if self.mode != 'live':
            logging.error("Start method only works in live mode")
            return
        
        self.running = True
        logging.info("Starting Trading Simulator...")
        
        # Start market data feeds
        for symbol, feed in self.market_data_feeds.items():
            # Subscribe active traders
            for trader_id in self.active_traders:
                trader = self.traders[trader_id]
                if hasattr(trader, 'symbol') and trader.symbol == symbol:
                    feed.subscribe(trader)
            
            # Start feed thread
            thread = threading.Thread(target=feed.start)
            thread.start()
            self.threads.append(thread)
        
        # Start traders
        for trader_id in self.active_traders:
            trader = self.traders[trader_id]
            thread = threading.Thread(target=self._run_trader, args=(trader,))
            thread.start()
            self.threads.append(thread)
        
        # Start risk monitoring
        risk_thread = threading.Thread(target=self._monitor_risk)
        risk_thread.start()
        self.threads.append(risk_thread)
        
        logging.info("Trading Simulator started successfully!")
    
    def _run_trader(self, trader: AlgorithmicTrader):
        """Run a trader in its own thread"""
        while self.running:
            try:
                trader.trade()
                time.sleep(trader.interval)
            except Exception as e:
                logging.error(f"Error in trader {trader.__class__.__name__}: {e}")
    
    def _monitor_risk(self):
        """Monitor risk metrics in real-time"""
        while self.running:
            try:
                metrics = self.get_risk_metrics()
                
                # Check for risk breaches
                if metrics['daily_pnl_pct'] < -self.risk_manager.max_daily_loss * 100:
                    logging.warning("Daily loss limit approaching!")
                    # Could implement automatic trader shutdown here
                
                time.sleep(5)  # Check every 5 seconds
            except Exception as e:
                logging.error(f"Error in risk monitoring: {e}")
    
    def stop(self):
        """Stop the trading simulator"""
        logging.info("Stopping Trading Simulator...")
        self.running = False
        
        # Stop market data feeds
        for feed in self.market_data_feeds.values():
            feed.stop()
        
        # Stop traders
        for trader_id in self.active_traders:
            self.traders[trader_id].stop()
        
        # Wait for threads to complete
        for thread in self.threads:
            thread.join(timeout=5)
        
        logging.info("Trading Simulator stopped!")
        
        # Generate final report
        self.generate_report()
    
    def generate_report(self, save_to_file: bool = True):
        """Generate comprehensive performance report"""
        report = self.performance_analyzer.generate_performance_report()
        
        # Print summary
        print("\n" + "="*50)
        print("TRADING SIMULATOR PERFORMANCE REPORT")
        print("="*50)
        
        for key, value in report.items():
            if isinstance(value, float):
                print(f"{key}: {value:.2f}")
            else:
                print(f"{key}: {value}")
        
        # Generate plots
        self.performance_analyzer.plot_performance()
        
        # Save to file
        if save_to_file:
            self.performance_analyzer.export_results()
        
        return report
    
    def run_backtest(self, symbols: List[str], start_date: str, end_date: str,
                    traders_config: List[Dict] = None) -> Dict:
        """Run a backtest with specified configuration"""
        if self.mode != 'backtest':
            # Reinitialize in backtest mode
            self.__init__(self.initial_capital, mode='backtest')
        
        # Create backtest engine
        backtest = BacktestEngine(self.initial_capital)
        
        # Load data
        backtest.load_historical_data(symbols, start_date, end_date)
        
        # Add traders
        if traders_config:
            for config in traders_config:
                trader_type = config.pop('type')
                trader = self.create_trader(trader_type, **config)
                backtest.add_trader(trader)
        
        # Run backtest
        results = backtest.run_backtest(start_date, end_date)
        
        # Generate visualization
        analyzer = PerformanceAnalyzer(
            backtest.portfolio_manager, 
            backtest.order_book
        )
        analyzer.plot_performance()
        
        return results## Comprehensive Trading Simulator Classclass BacktestEngine:
    def __init__(self, initial_capital: float = 100000):
        self.initial_capital = initial_capital
        self.portfolio_manager = PortfolioManager(initial_capital)
        self.order_book = EnhancedOrderBook()
        self.risk_manager = RiskManager()
        self.matching_engine = EnhancedMatchingEngine(
            self.order_book, self.portfolio_manager, self.risk_manager
        )
        self.market_event_simulator = MarketEventSimulator()
        self.traders = []
        self.market_data_cache = {}
        self.current_prices = {}
        
    def add_trader(self, trader: AlgorithmicTrader):
        """Add a trader to the backtest"""
        self.traders.append(trader)
        
    def load_historical_data(self, symbols: List[str], start_date: str, end_date: str):
        """Load historical data for multiple symbols"""
        for symbol in symbols:
            data = yf.download(symbol, start=start_date, end=end_date, interval='1d')
            data.reset_index(inplace=True)
            self.market_data_cache[symbol] = data
            logging.info(f"Loaded {len(data)} days of data for {symbol}")
    
    def preprocess_data(self):
        """Align all symbol data to common dates"""
        # Get all unique dates
        all_dates = set()
        for symbol_data in self.market_data_cache.values():
            all_dates.update(symbol_data['Date'].tolist())
        
        # Sort dates
        all_dates = sorted(list(all_dates))
        
        # Create aligned data
        aligned_data = {}
        for date in all_dates:
            aligned_data[date] = {}
            for symbol, data in self.market_data_cache.items():
                date_data = data[data['Date'] == date]
                if not date_data.empty:
                    aligned_data[date][symbol] = {
                        'open': float(date_data['Open'].iloc[0]),
                        'high': float(date_data['High'].iloc[0]),
                        'low': float(date_data['Low'].iloc[0]),
                        'close': float(date_data['Close'].iloc[0]),
                        'volume': float(date_data['Volume'].iloc[0])
                    }
        
        return aligned_data
    
    def simulate_intraday_prices(self, daily_data: Dict, num_ticks: int = 100) -> List[Dict]:
        """Simulate intraday price movements from daily OHLCV data"""
        intraday_prices = []
        
        for symbol, data in daily_data.items():
            # Generate realistic intraday price path
            open_price = data['open']
            high_price = data['high']
            low_price = data['low']
            close_price = data['close']
            
            # Create price path that respects OHLC constraints
            prices = [open_price]
            
            # Random walk with drift towards close
            for i in range(1, num_ticks - 1):
                progress = i / num_ticks
                
                # Bias towards close price as day progresses
                target = open_price * (1 - progress) + close_price * progress
                
                # Add noise
                noise = np.random.normal(0, (high_price - low_price) / 100)
                new_price = prices[-1] + (target - prices[-1]) * 0.1 + noise
                
                # Ensure price stays within daily range
                new_price = max(low_price, min(high_price, new_price))
                prices.append(new_price)
            
            # Ensure last price is close price
            prices.append(close_price)
            
            # Create intraday ticks
            for i, price in enumerate(prices):
                tick_time = i / num_ticks  # Fraction of day
                intraday_prices.append({
                    'symbol': symbol,
                    'price': price,
                    'volume': data['volume'] / num_ticks,
                    'tick_time': tick_time
                })
        
        return intraday_prices
    
    def run_backtest(self, start_date: str = None, end_date: str = None, 
                    simulate_events: bool = True, event_probability: float = 0.01):
        """Run the backtest simulation"""
        # Preprocess data
        aligned_data = self.preprocess_data()
        
        # Filter by date range if specified
        if start_date:
            aligned_data = {k: v for k, v in aligned_data.items() if k >= pd.to_datetime(start_date)}
        if end_date:
            aligned_data = {k: v for k, v in aligned_data.items() if k <= pd.to_datetime(end_date)}
        
        # Initialize risk manager
        self.risk_manager.reset_daily_stats(self.portfolio_manager)
        
        # Main simulation loop
        for date, daily_data in aligned_data.items():
            logging.info(f"\nSimulating date: {date}")
            
            # Generate intraday prices
            intraday_ticks = self.simulate_intraday_prices(daily_data)
            
            # Reset daily risk stats
            self.risk_manager.reset_daily_stats(self.portfolio_manager)
            
            # Process each intraday tick
            for tick in intraday_ticks:
                # Update current price
                self.current_prices[tick['symbol']] = tick['price']
                
                # Update portfolio market prices
                self.portfolio_manager.update_market_prices(self.current_prices)
                
                # Simulate market events
                if simulate_events and random.random() < event_probability:
                    self._simulate_random_event(tick['symbol'])
                
                # Broadcast to traders
                market_data = {
                    'symbol': tick['symbol'],
                    'price': tick['price'],
                    'timestamp': date,
                    'volume': tick['volume']
                }
                
                for trader in self.traders:
                    trader.receive(market_data)
                    trader.trade()
            
            # End of day processing
            self._end_of_day_processing(date)
        
        logging.info("\nBacktest completed!")
        
        # Generate final report
        analyzer = PerformanceAnalyzer(self.portfolio_manager, self.order_book)
        return analyzer.generate_performance_report()
    
    def _simulate_random_event(self, symbol: str):
        """Simulate a random market event"""
        event_types = list(MarketEventType)
        event_type = random.choice(event_types)
        
        event = MarketEvent(
            event_type=event_type,
            timestamp=datetime.now(),
            duration=timedelta(minutes=random.randint(5, 60)),
            magnitude=random.uniform(0.1, 0.8),
            affected_symbols=[symbol],
            metadata={
                'direction': random.choice([1, -1]),
                'earnings_surprise': random.uniform(-5, 5)
            }
        )
        
        # Apply event to market
        adjusted_prices = self.market_event_simulator.simulate_event(
            event, self.current_prices, self.order_book
        )
        self.current_prices.update(adjusted_prices)
    
    def _end_of_day_processing(self, date):
        """Perform end-of-day tasks"""
        # Update equity curve
        self.portfolio_manager.equity_curve.append(
            (date, self.portfolio_manager.total_value)
        )
        
        # Log daily summary
        daily_pnl = self.risk_manager.daily_pnl
        total_value = self.portfolio_manager.total_value
        logging.info(f"End of day {date}: Portfolio Value: ${total_value:,.2f}, "
                    f"Daily P&L: ${daily_pnl:,.2f}")
    
    def optimize_parameters(self, parameter_grid: Dict, metric: str = 'sharpe_ratio'):
        """Run parameter optimization"""
        best_params = None
        best_metric = -float('inf')
        results = []
        
        # Generate all parameter combinations
        param_names = list(parameter_grid.keys())
        param_values = [parameter_grid[name] for name in param_names]
        
        from itertools import product
        for params in product(*param_values):
            param_dict = dict(zip(param_names, params))
            
            logging.info(f"Testing parameters: {param_dict}")
            
            # Reset state
            self.__init__(self.initial_capital)
            
            # Configure traders with parameters
            # This is a simplified example - you'd need to implement parameter setting
            # for each trader type
            
            # Run backtest
            report = self.run_backtest()
            
            # Extract metric
            metric_value = report.get(metric, 0)
            results.append({
                'parameters': param_dict,
                'metric': metric_value,
                'report': report
            })
            
            if metric_value > best_metric:
