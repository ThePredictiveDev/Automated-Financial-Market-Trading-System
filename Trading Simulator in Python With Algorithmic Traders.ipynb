        }## Enhanced Backtesting Frameworkclass PerformanceAnalyzer:
    def __init__(self, portfolio_manager: PortfolioManager, order_book: EnhancedOrderBook):
        self.portfolio_manager = portfolio_manager
        self.order_book = order_book
        
    def generate_performance_report(self) -> Dict:
        """Generate comprehensive performance report"""
        metrics = self.portfolio_manager.get_performance_metrics()
        
        # Add additional metrics
        metrics.update({
            'avg_trade_size': self._calculate_avg_trade_size(),
            'trade_frequency': self._calculate_trade_frequency(),
            'profit_factor': self._calculate_profit_factor(),
            'avg_win': self._calculate_avg_win(),
            'avg_loss': self._calculate_avg_loss(),
            'largest_win': self._calculate_largest_win(),
            'largest_loss': self._calculate_largest_loss(),
            'consecutive_wins': self._calculate_max_consecutive_wins(),
            'consecutive_losses': self._calculate_max_consecutive_losses(),
            'calmar_ratio': self._calculate_calmar_ratio(),
            'sortino_ratio': self._calculate_sortino_ratio()
        })
        
        return metrics
    
    def _calculate_avg_trade_size(self) -> float:
        """Calculate average trade size"""
        if not self.portfolio_manager.transaction_history:
            return 0
        
        total_size = sum(abs(tx['quantity'] * tx['price']) for tx in self.portfolio_manager.transaction_history)
        return total_size / len(self.portfolio_manager.transaction_history)
    
    def _calculate_trade_frequency(self) -> float:
        """Calculate trades per day"""
        if not self.portfolio_manager.transaction_history:
            return 0
        
        first_trade = self.portfolio_manager.transaction_history[0]['timestamp']
        last_trade = self.portfolio_manager.transaction_history[-1]['timestamp']
        days = max((last_trade - first_trade).days, 1)
        
        return len(self.portfolio_manager.transaction_history) / days
    
    def _get_trade_pnls(self) -> List[float]:
        """Extract P&L for each completed trade"""
        pnls = []
        symbol_trades = {}
        
        for tx in self.portfolio_manager.transaction_history:
            symbol = tx['symbol']
            if symbol not in symbol_trades:
                symbol_trades[symbol] = {'position': 0, 'cost_basis': 0}
            
            trade_data = symbol_trades[symbol]
            
            if trade_data['position'] == 0:
                # Opening new position
                trade_data['position'] = tx['quantity']
                trade_data['cost_basis'] = tx['price']
            elif (trade_data['position'] > 0 and tx['quantity'] < 0) or \
                 (trade_data['position'] < 0 and tx['quantity'] > 0):
                # Closing or reducing position
                close_quantity = min(abs(tx['quantity']), abs(trade_data['position']))
                pnl = (tx['price'] - trade_data['cost_basis']) * close_quantity
                if trade_data['position'] < 0:
                    pnl = -pnl
                pnls.append(pnl)
                
                # Update position
                trade_data['position'] += tx['quantity']
                if trade_data['position'] != 0:
                    trade_data['cost_basis'] = tx['price']
            else:
                # Adding to position
                total_cost = trade_data['position'] * trade_data['cost_basis'] + tx['quantity'] * tx['price']
                trade_data['position'] += tx['quantity']
                trade_data['cost_basis'] = total_cost / trade_data['position'] if trade_data['position'] != 0 else 0
        
        return pnls
    
    def _calculate_profit_factor(self) -> float:
        """Calculate profit factor (gross profit / gross loss)"""
        pnls = self._get_trade_pnls()
        if not pnls:
            return 0
        
        gross_profit = sum(pnl for pnl in pnls if pnl > 0)
        gross_loss = abs(sum(pnl for pnl in pnls if pnl < 0))
        
        return gross_profit / gross_loss if gross_loss > 0 else float('inf')
    
    def _calculate_avg_win(self) -> float:
        """Calculate average winning trade"""
        pnls = self._get_trade_pnls()
        wins = [pnl for pnl in pnls if pnl > 0]
        return np.mean(wins) if wins else 0
    
    def _calculate_avg_loss(self) -> float:
        """Calculate average losing trade"""
        pnls = self._get_trade_pnls()
        losses = [pnl for pnl in pnls if pnl < 0]
        return np.mean(losses) if losses else 0
    
    def _calculate_largest_win(self) -> float:
        """Calculate largest winning trade"""
        pnls = self._get_trade_pnls()
        wins = [pnl for pnl in pnls if pnl > 0]
        return max(wins) if wins else 0
    
    def _calculate_largest_loss(self) -> float:
        """Calculate largest losing trade"""
        pnls = self._get_trade_pnls()
        losses = [pnl for pnl in pnls if pnl < 0]
        return min(losses) if losses else 0
    
    def _calculate_max_consecutive_wins(self) -> int:
        """Calculate maximum consecutive winning trades"""
        pnls = self._get_trade_pnls()
        if not pnls:
            return 0
        
        max_consecutive = 0
        current_consecutive = 0
        
        for pnl in pnls:
            if pnl > 0:
                current_consecutive += 1
                max_consecutive = max(max_consecutive, current_consecutive)
            else:
                current_consecutive = 0
        
        return max_consecutive
    
    def _calculate_max_consecutive_losses(self) -> int:
        """Calculate maximum consecutive losing trades"""
        pnls = self._get_trade_pnls()
        if not pnls:
            return 0
        
        max_consecutive = 0
        current_consecutive = 0
        
        for pnl in pnls:
            if pnl < 0:
                current_consecutive += 1
                max_consecutive = max(max_consecutive, current_consecutive)
            else:
                current_consecutive = 0
        
        return max_consecutive
    
    def _calculate_calmar_ratio(self) -> float:
        """Calculate Calmar ratio (annual return / max drawdown)"""
        if not self.portfolio_manager.equity_curve or len(self.portfolio_manager.equity_curve) < 2:
            return 0
        
        # Calculate annualized return
        start_value = self.portfolio_manager.equity_curve[0][1]
        end_value = self.portfolio_manager.equity_curve[-1][1]
        days = (self.portfolio_manager.equity_curve[-1][0] - self.portfolio_manager.equity_curve[0][0]).days
        
        if days == 0:
            return 0
        
        annual_return = ((end_value / start_value) ** (365 / days) - 1) * 100
        max_dd = self.portfolio_manager._calculate_max_drawdown()
        
        return annual_return / max_dd if max_dd > 0 else 0
    
    def _calculate_sortino_ratio(self) -> float:
        """Calculate Sortino ratio (uses downside deviation)"""
        if len(self.portfolio_manager.equity_curve) < 2:
            return 0
        
        returns = []
        for i in range(1, len(self.portfolio_manager.equity_curve)):
            prev_value = self.portfolio_manager.equity_curve[i-1][1]
            curr_value = self.portfolio_manager.equity_curve[i][1]
            if prev_value != 0:
                returns.append((curr_value - prev_value) / prev_value)
        
        if not returns:
            return 0
        
        # Calculate downside deviation
        negative_returns = [r for r in returns if r < 0]
        if not negative_returns:
            return float('inf') if np.mean(returns) > 0 else 0
        
        downside_deviation = np.std(negative_returns)
        if downside_deviation == 0:
            return 0
        
        # Annualize
        periods_per_year = 252
        avg_return = np.mean(returns) * periods_per_year
        downside_deviation = downside_deviation * np.sqrt(periods_per_year)
        risk_free_rate = 0.02
        
        return (avg_return - risk_free_rate) / downside_deviation
    
    def plot_performance(self):
        """Generate performance visualization plots"""
        fig, axes = plt.subplots(2, 2, figsize=(15, 10))
        
        # Equity curve
        times = [ec[0] for ec in self.portfolio_manager.equity_curve]
        values = [ec[1] for ec in self.portfolio_manager.equity_curve]
        axes[0, 0].plot(times, values, 'b-', linewidth=2)
        axes[0, 0].set_title('Equity Curve')
        axes[0, 0].set_xlabel('Time')
        axes[0, 0].set_ylabel('Portfolio Value')
        axes[0, 0].grid(True, alpha=0.3)
        
        # Drawdown
        peak = values[0]
        drawdowns = []
        for value in values:
            if value > peak:
                peak = value
            drawdowns.append((peak - value) / peak * 100)
        
        axes[0, 1].fill_between(times, 0, drawdowns, color='red', alpha=0.3)
        axes[0, 1].plot(times, drawdowns, 'r-', linewidth=1)
        axes[0, 1].set_title('Drawdown')
        axes[0, 1].set_xlabel('Time')
        axes[0, 1].set_ylabel('Drawdown %')
        axes[0, 1].grid(True, alpha=0.3)
        axes[0, 1].invert_yaxis()
        
        # P&L distribution
        pnls = self._get_trade_pnls()
