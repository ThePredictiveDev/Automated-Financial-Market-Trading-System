   "outputs": [],
   "source": [
    "class EMABasedTrader(AlgorithmicTrader):\n",
    "    def __init__(self, symbol, matching_engine, interval=0.1, short_window=5, long_window=20):\n",
    "        super().__init__(symbol, matching_engine, interval)\n",
    "        self.short_window = short_window\n",
    "        self.long_window = long_window\n",
    "        self.prices = []\n",
    "\n",
    "    def handle_market_data(self, data):\n",
    "        self.prices.append(self.current_price)\n",
    "        if len(self.prices) > self.long_window:\n",
    "            self.prices.pop(0)\n",
    "\n",
    "    def trade(self):\n",
    "        if len(self.prices) < self.long_window:\n",
    "            return\n",
    "\n",
    "        short_ema = self.calculate_ema(self.short_window)\n",
    "        long_ema = self.calculate_ema(self.long_window)\n",
    "\n",
    "        if short_ema > long_ema:\n",
    "            # Buy\n",
    "            order = Order(id=str(random.randint(10000, 99999)), price=self.current_price, quantity=100, side='buy', type='limit', symbol=self.symbol)\n",
    "            self.matching_engine.match_order(order)\n",
    "            logging.info(f\"EMABasedTrader placed a buy order at {self.current_price}\")\n",
    "        elif short_ema < long_ema:\n",
    "            # Sell\n",
    "            order = Order(id=str(random.randint(10000, 99999)), price=self.current_price, quantity=100, side='sell', type='limit', symbol=self.symbol)\n",
    "            self.matching_engine.match_order(order)\n",
    "            logging.info(f\"EMABasedTrader placed a sell order at {self.current_price}\")\n",
    "\n",
    "    def calculate_ema(self, window):\n",
    "        weights = np.exp(np.linspace(-1., 0., window))\n",
    "        weights /= weights.sum()\n",
    "        a = np.convolve(self.prices, weights, mode='valid')\n",
    "        return a[-1]\n"
   ]
  },
